@theme "/dev/null"

* {
	bg: @COLOR_BG@;
	background-color: @bg;
}


configuration {
	show-icons: true;
	icon-theme: "Papirus";
	location: 0;
	font: "Hack Regular 9";
	display-drun: "[Search]";
	/* custom rofi keybindings */
	kb-mode-next: "Super+l";
	kb-mode-previous: "Super+h";
	kb-row-down: "<Control>n";
	kb-row-up: "<Control>p";
}

window {
	width: 35%;
	transparency: "real";
	orientation: vertical;
	border: 2px;
	border-color: @COLOR_ACCENT@;
}

mainbox {
	children: [inputbar, listview];
}


// ELEMENT
// -----------------------------------

element {
	padding: 4 12;
	text-color: @COLOR_FG@;
}

element selected {
	background-color: @COLOR_BG_HOVER@;
}

element-text {
	background-color: inherit;
	text-color: inherit;
}

element-icon {
	size: 24 px;
	background-color: inherit;
	padding: 0 6 0 0;
	alignment: vertical;
}

listview {
	columns: 1;
	lines: 9;
	padding: 8 0;
	fixed-height: true;
	fixed-columns: true;
	fixed-lines: true;
	border: 0 10 6 10;
}

// INPUT BAR
//------------------------------------------------

entry {
	text-color: @COLOR_FG@;
	padding: 10 10 0 0;
	margin: 0 -2 0 0;
}

prompt {
	text-color: @COLOR_FG@;
	padding: 10 6 0 10;
	margin: 0 -2 0 0;
}
