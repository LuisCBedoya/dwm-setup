* {
    background:     @COLOR_BG@;
    background-alt: @COLOR_BG_ALT@;
    foreground:     @COLOR_FG@;
    selected:       @COLOR_ACCENT@;
    active:         @COLOR_GREEN@;
    urgent:         @COLOR_RED@;
    border:         @COLOR_BORDER@;
}

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    font: "@FONT@ @FONT_SIZE@";
    dpi: 96;
}

window {
    width: 360px;
    height: 100%;
    location: west;
    anchor: west;
    x-offset: 0;
    y-offset: 0;
    fullscreen: false;
    monitor: -1;
    background-color: @COLOR_BG@;
    border: 2;
    border-radius: 0;
    border-color: @COLOR_BORDER@;
    padding: 20;
}

mainbox {
    expand: true;
    children: [ "message", "listview" ];
    background-color: transparent;
}

message {
    background-color: @COLOR_BG_ALT@;
    text-color: @COLOR_FG@;
    padding: 10;
    margin: 0 0 10 0;
    border-radius: 0;
    text: "  Power Menu";
}

listview {
    columns: 1;
    lines: 0;
    dynamic: false;
    fixed-height: false;
    spacing: 6;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 10;
    border-radius: 0;
    background-color: transparent;
    text-color: @COLOR_FG@;
}

element.normal.normal {
    background-color: transparent;
}

element.normal.active {
    background-color: @COLOR_BG_ALT@;
}

element-text {
    font: "@FONT@ @FONT_SIZE@";
    vertical-align: 0.5;
    background-color: inherit;
}

element-icon {
    size: 28;
    vertical-align: 0.5;
    background-color: inherit;
}