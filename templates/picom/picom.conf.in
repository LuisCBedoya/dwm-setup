# picom.conf — generado desde template; no editar directamente.
# Config mínima: vsync contra el rasgado al arrastrar/scroll.
# Fade sutil y sombras sutiles; SIN blur y SIN transparencias de picom.
# mpv a pantalla completa pasa sin composite (rendimiento).

backend = "glx";
vsync = true;
use-damage = true;

# Sombras sutiles (ADR-110). Barra (dock) y escritorio excluidos.
shadow = true;
shadow-radius = 10;
shadow-opacity = 0.35;
shadow-offset-x = -8;
shadow-offset-y = -8;
shadow-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'"
];
# Esquinas redondeadas (solo ventanas normales); dock/notificaciones/
# escritorio quedan fuera para no dejar huecos ni marcos descuadrados.
corner-radius = 10;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'notification'",
  "window_type = 'desktop'"
];
fading = true;
fade-delta = 5;
fade-in-step = 0.05;
fade-out-step = 0.05;
fade-exclude = [
  "window_type = 'dock'",
  "window_type = 'notification'",
  "window_type = 'desktop'"
];

# Sin transparencias ni blur: opacidad siempre al 100 %.
inactive-opacity = 1;
active-opacity = 1;
frame-opacity = 1;

# mpv/vídeo a pantalla completa pasa sin composite.
unredir-if-possible = true;

detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;
