# picom.conf — generado desde template
# Paleta: @THEME_NAME@ (Nord)

backend = "glx";
vsync = true;

# Sombras
shadow = false;
shadow-radius = 7;
shadow-offset-x = 0;
shadow-offset-y = 0;
shadow-opacity = 0.3;

# Esquinas redondeadas
corner-radius = 7;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "_NET_WM_WINDOW_TYPE_DOCK",
  "_NET_WM_WINDOW_TYPE_DESKTOP"
];

# Transparencias
inactive-opacity = 1;
active-opacity = 1;
frame-opacity = 1;
inactive-opacity-override = false;

# Fading
fading = true;
fade-delta = 4;
fade-in-step = 0.03;
fade-out-step = 0.03;

# Exclusiones
blur-background = false;
blur-background-frame = false;
blur-kern = "3x3box";

# Configuración de ventanas
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-rounded-corners = true;

# XRender sync
xrender-sync = true;
xrender-sync-fence = true;

# Excluir ciertas ventanas de sombras/redondeo
shadow-exclude = [
  "window_type = 'notification'",
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "_GTK_FRAME_EXTENTS@:c",
  "class_g = 'Conky'",
  "class_g = 'Krita'",
  "class_g = 'Pinentry'",
  "class_g = 'feh'",
  "name = 'Picture-in-Picture'",
  "_NET_WM_STATE@:32a *= '_NET_WM_STATE_HIDDEN'",
  "_NET_WM_STATE@:32a *= '_NET_WM_STATE_FULLSCREEN'"
];

fade-exclude = [
  "window_type = 'notification'",
  "window_type = 'dock'",
  "window_type = 'desktop'",
];

# GLX backend optimizations
glx-no-stencil = true;
glx-copy-from-front = false;
glx-use-copysubbuffermesa = true;
glx-no-rebind-pixmap = true;
glx-swap-method = "undefined";

# Detección de transparecias
detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;

# Refresh rate
refresh-rate = 0;
use-damage = true;

# DBus
dbus = true;