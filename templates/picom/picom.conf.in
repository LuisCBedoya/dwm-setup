# picom.conf — generado desde template; no editar directamente.
# Config mínima: vsync contra el rasgado al arrastrar/scroll.
# Fade sutil y sombras sutiles; SIN blur y SIN transparencias de picom.
# mpv a pantalla completa pasa sin composite (rendimiento).

backend = "glx";
vsync = true;
use-damage = true;

# Sombras sutiles (ADR-110). Barra (dock), escritorio, menús y popups
# quedan fuera: los menús ya dibujan su propia sombra y, al ser ARGB con
# márgenes transparentes, la sombra de picom se vería como un segundo
# recuadro (p. ej. el menú contextual de Brave).
shadow = true;
shadow-radius = 10;
shadow-opacity = 0.35;
shadow-offset-x = -8;
shadow-offset-y = -8;
shadow-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "window_type = 'menu'",
  "window_type = 'popup_menu'",
  "window_type = 'dropdown_menu'",
  "window_type = 'tooltip'",
  "class_g = 'Rofi'",
  "class_i = 'rofi'"
];
# Esquinas redondeadas (solo ventanas normales); dock/notificaciones/
# escritorio y menús/popups quedan fuera para no dejar huecos ni marcos
# descuadrados (p. ej. el menú contextual de Brave).
corner-radius = 10;
rounded-corners-exclude = [
  "window_type = 'dock'",
  "window_type = 'notification'",
  "window_type = 'desktop'",
  "window_type = 'menu'",
  "window_type = 'popup_menu'",
  "window_type = 'dropdown_menu'",
  "window_type = 'tooltip'",
  "class_g = 'Rofi'",
  "class_i = 'rofi'"
];
fading = true;
fade-delta = 5;
fade-in-step = 0.035;
fade-out-step = 0.035;
fade-exclude = [
  "window_type = 'dock'",
  "window_type = 'notification'",
  "window_type = 'desktop'",
  "class_g = 'Rofi'",
  "class_i = 'rofi'"
];

# Sin transparencias ni blur: opacidad siempre al 100 %.
inactive-opacity = 1;
active-opacity = 1;
frame-opacity = 1;

# mpv/vídeo a pantalla completa pasa sin composite.
unredir-if-possible = true;

detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;
