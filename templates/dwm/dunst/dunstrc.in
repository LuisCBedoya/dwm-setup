# Dunst configuration for @THEME_NAME@ theme
# Generated from palette-@THEME_NAME@.sh — do not edit directly

[global]
    monitor = 0
    follow = mouse
    geometry = "360x200-30+60"
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 16
    frame_width = 2
    frame_color = "@COLOR_ACCENT@"
    separator_color = "@COLOR_BORDER@"
    corner_radius = 10
    font = "JetBrainsMono Nerd Font 10"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = "/usr/share/icons/Gruvbox-Material-Dark:/usr/share/icons/Papirus-Dark:/usr/share/icons/Adwaita"
    enable_recursive_icon_lookup = true
    sticky_history = yes
    history_length = 20
    dmenu = "/usr/bin/rofi -dmenu -p dunst:"
    browser = "/usr/bin/xdg-open"
    always_run_script = true
    title = "Dunst"
    class = "Dunst"
    startup_notification = false
    verbosity = mesg

[experimental]
    per_monitor_dpi = false
    ignore_dbusclose = false
    force_xinerama = false
    allow_markup = true

[urgency_low]
    background = "@COLOR_BG_ALT@"
    foreground = "@COLOR_FG_MUTED@"
    frame_color = "@COLOR_BORDER@"
    timeout = 5

[urgency_normal]
    background = "@COLOR_BG_ALT@"
    foreground = "@COLOR_FG@"
    frame_color = "@COLOR_ACCENT@"
    timeout = 8

[urgency_critical]
    background = "@COLOR_BG_ALT@"
    foreground = "@COLOR_FG@"
    frame_color = "@COLOR_RED@"
    timeout = 0

# Reglas para notificaciones de scripts (volume, brightness, etc.)
[volume-notifs]
    appname = "volume"
    icon_size = 28
    timeout = 1
    format = "%b"

[scripts-notifs]
    appname = "scripts"
    icon_size = 28
    timeout = 1

# Música (mpd/playerctl)
[music-notifs]
    appname = "music"
    timeout = 5
    format = "<b>%s</b>\n%b"

# Batería crítica
[battery-critical]
    appname = "battery"
    urgency = critical
    timeout = 0
    format = "<b>⚠ Batería crítica</b>\n%b"