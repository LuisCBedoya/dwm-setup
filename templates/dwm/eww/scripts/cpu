#!/bin/sh
# Obtiene uso CPU promedio (0-100)
# Formato: JSON { "avg": 45 }

read -r _ user nice system idle iowait irq softirq steal rest < /proc/stat 2>/dev/null || exit 1
total=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_all=$((idle + iowait))

# Leer valores previos de archivo temporal
prev_file="/tmp/dwm-eww-cpu-prev"
if [ -f "$prev_file" ]; then
    read prev_total prev_idle < "$prev_file"
else
    prev_total=0
    prev_idle=0
fi

echo "$total $idle_all" > "$prev_file"

dt=$((total - prev_total))
di=$((idle_all - prev_idle))

if [ "$dt" -gt 0 ]; then
    usage=$((100 * (dt - di) / dt))
else
    usage=0
fi

printf '{"avg":%d}\n' "$usage"