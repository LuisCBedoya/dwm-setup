#!/bin/sh
# Obtiene estado Bluetooth
# Para uso en eww control center

# Verificar si bluetoothctl está disponible
command -v bluetoothctl >/dev/null 2>&1 || { echo "󰂲 N/A"; exit 0; }

# Verificar si el controlador está encendido
powered=$(bluetoothctl show 2>/dev/null | grep -i "Powered: yes")
if [ -z "$powered" ]; then
    echo "󰂲 Off"
    exit 0
fi

# Verificar dispositivos conectados
connected=$(bluetoothctl info 2>/dev/null | grep -c "Connected: yes")
if [ "$connected" -gt 0 ]; then
    device=$(bluetoothctl info 2>/dev/null | grep "Name:" | head -1 | cut -d: -f2- | sed 's/^ //')
    [ -n "$device" ] && echo "󰂯 $device" || echo "󰂯 Conectado"
else
    echo "󰂯 On"
fi