#!/bin/sh
# Obtiene info RAM
# Formato: JSON { "used_mem_perc": 45, "used_mem_human": "3.2G", "total_mem_human": "7.8G" }

meminfo=$(free -b 2>/dev/null | awk '/^Mem:/ {print $2, $3, $4}')
if [ -z "$meminfo" ]; then
    printf '{"used_mem_perc":0,"used_mem_human":"N/A","total_mem_human":"N/A"}\n'
    exit 0
fi

total=$(echo "$meminfo" | awk '{print $1}')
used=$(echo "$meminfo" | awk '{print $2}')

if [ "$total" -gt 0 ]; then
    perc=$((used * 100 / total))
else
    perc=0
fi

used_human=$(echo "$used" | awk '{split("B KB MB GB TB", u); for(i=1; $1>=1024 && i<5; i++) $1/=1024; printf "%.1f%s", $1, u[i]}')
total_human=$(echo "$total" | awk '{split("B KB MB GB TB", u); for(i=1; $1>=1024 && i<5; i++) $1/=1024; printf "%.1f%s", $1, u[i]}')

printf '{"used_mem_perc":%d,"used_mem_human":"%s","total_mem_human":"%s"}\n' "$perc" "$used_human" "$total_human"