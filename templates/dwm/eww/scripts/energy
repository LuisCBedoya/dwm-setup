#!/bin/sh
# Modo de energía (auto-cpufreq, tuned, power-profiles-daemon)
# Para uso en eww control center

# Intentar power-profiles-daemon (GNOME/Fedora/reciente Debian)
if command -v powerprofilesctl >/dev/null 2>&1; then
    profile=$(powerprofilesctl get 2>/dev/null)
    case "$profile" in
        performance) echo "󰓅 Rendimiento" ;;
        balanced) echo "󰾅 Equilibrado" ;;
        power-saver) echo "󰾆 Ahorro" ;;
        *) echo "󰾅 $profile" ;;
    esac
    exit 0
fi

# Intentar auto-cpufreq
if command -v auto-cpufreq >/dev/null 2>&1; then
    mode=$(auto-cpufreq --get-governor 2>/dev/null | head -1)
    case "$mode" in
        performance) echo "󰓅 Rendimiento" ;;
        powersave) echo "󰾆 Ahorro" ;;
        *) echo "󰾅 $mode" ;;
    esac
    exit 0
fi

# Intentar tuned
if command -v tuned-adm >/dev/null 2>&1; then
    profile=$(tuned-adm active 2>/dev/null | grep -o 'Current active profile: .*' | cut -d: -f2- | sed 's/^ //')
    [ -n "$profile" ] && echo "󰾅 $profile" || echo "󰾅 N/A"
    exit 0
fi

# Fallback: cpufreq
governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
case "$governor" in
    performance) echo "󰓅 Rendimiento" ;;
    powersave) echo "󰾆 Ahorro" ;;
    ondemand|schedutil) echo "󰾅 Equilibrado" ;;
    *) echo "󰾅 ${governor:-N/A}" ;;
esac