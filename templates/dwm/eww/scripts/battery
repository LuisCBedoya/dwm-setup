#!/bin/sh
# Obtiene porcentaje de batería y estado
# Para uso en barra y eww

bat_path="/sys/class/power_supply/BAT0"
[ -d "$bat_path" ] || bat_path="/sys/class/power_supply/BAT1"

if [ -f "$bat_path/capacity" ]; then
    cap=$(cat "$bat_path/capacity" 2>/dev/null) || cap=0
    status=$(cat "$bat_path/status" 2>/dev/null) || status="Unknown"
    
    case "$status" in
        Charging) icon="󰂄" ;;
        Full) icon="󰁹" ;;
        *) 
            if [ "$cap" -ge 90 ]; then icon="󰁹"
            elif [ "$cap" -ge 70 ]; then icon="󰂀"
            elif [ "$cap" -ge 50 ]; then icon="󰁿"
            elif [ "$cap" -ge 30 ]; then icon="󰁾"
            elif [ "$cap" -ge 15 ]; then icon="󰁽"
            else icon="󰂃"
            fi
            ;;
    esac
    
    echo "${icon} ${cap}%"
else
    echo "󰂑 N/A"
fi