(include "vars.yuck")
(include "widgets.yuck")

(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "18px" :y "46px" :width "350px" :height "400px" :anchor "top left")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (dashboard-widget))

(defwindow calendar
  :monitor 0
  :geometry (geometry :x "-18px" :y "46px" :width "330px" :height "310px" :anchor "top right")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (calendar-widget))

(defwindow control
  :monitor 0
  :geometry (geometry :x "-18px" :y "46px" :width "330px" :height "400px" :anchor "top right")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (control-widget))

(defwindow census
  :monitor 0
  :geometry (geometry :x "-18px" :y "-18px" :width "300px" :height "300px" :anchor "bottom right")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (census-widget))

(defwindow power
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "280px" :height "300px" :anchor "center")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  (power-widget))
