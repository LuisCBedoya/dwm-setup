(defpoll time :interval "1s" "date +'%H:%M'")
(defpoll date :interval "60s" "date +'%a %d %b'")
(defpoll longdate :interval "60s" "date +'%A, %d de %B de %Y'")
(defpoll user :interval "3600s" "whoami")
(defpoll host :interval "3600s" "hostname")
(defpoll uptime :interval "60s" "$HOME/.config/dwm/eww/scripts/uptime")
(defpoll temp :interval "2s" "$HOME/.config/dwm/eww/scripts/temp")
(defpoll volume :interval "1s" "$HOME/.config/dwm/eww/scripts/volume")
(defpoll brightness :interval "1s" "$HOME/.config/dwm/eww/scripts/brightness")
(defpoll wifi :interval "5s" "$HOME/.config/dwm/eww/scripts/wifi")
(defpoll battery :interval "60s" "$HOME/.config/dwm/eww/scripts/battery")
(defpoll updates :interval "1800s" "$HOME/.config/dwm/eww/scripts/updates")
