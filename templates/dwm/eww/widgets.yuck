;; Eww widgets for @THEME_NAME@ theme
;; Uses color variables from vars.yuck (defvar color-*)

(include "vars.yuck")

;; Helper para clases de gauge según valor
(defun gauge-class [val]
  (if (< val 30) "gauge-progress low"
    (if (< val 60) "gauge-progress medium"
      (if (< val 85) "gauge-progress high"
        "gauge-progress critical"))))

;; Helper para color de gauge según valor
(defun gauge-color [val]
  (if (< val 30) color-green
    (if (< val 60) color-yellow
      (if (< val 85) color-orange
        color-red))))

;; Statbar (barra horizontal con icono, label, valor, progress)
(defwidget statbar [icon label value color]
  (box :class "statbar" :orientation "h" :space-evenly false :spacing 8
    (label :class "stat-icon" :style "color: ${color};" :text icon)
    (box :class "stat-body" :orientation "v" :hexpand true :spacing 2
      (box :class "stat-top" :orientation "h"
        (label :class "stat-label" :hexpand true :text label)
        (label :class "stat-value" :text "${round(value, 0)}%"))
      (progress :class "stat-progress" :value value :hexpand true))
  )
)

;; Botón de acción simple (icono solo)
(defwidget action [icon command]
  (button :class "action" :onclick command
    (label :text icon))
)

;; Tile (icono + label, para toggles)
(defwidget tile [icon label command]
  (button :class "tile" :onclick command
    (box :orientation "v" :spacing 2 :halign "center"
      (label :class "tile-icon" :text icon)
      (label :class "tile-label" :text label)))
)

;; Slider para control center (volumen, brillo)
(defwidget cc-slider [label value command]
  (box :class "cc-slider" :orientation "v" :spacing 2
    (box :class "cc-slider-top" :orientation "h"
      (label :class "cc-label" :hexpand true :text label)
      (label :class "cc-value" :text value))
    (scale :class "cc-scale" :value value :min 0 :max 100 :onchange command :orientation "h" :hexpand true))
)

;; Gauge circular (CPU, RAM, disco, temp)
(defwidget gauge [value label icon]
  (box :class "gauge" :orientation "v" :spacing 2
    (circular-progress :class (gauge-class value) :value value :thickness 6
      (box :orientation "v" :halign "center" :valign "center" :spacing 0
        (label :class "gauge-icon" :text icon)
        (label :class "gauge-value" :text "${round(value, 0)}%")))
    (label :class "gauge-label" :text label))
)

;; =====================================================================
;; VENTANAS
;; =====================================================================

;; Dashboard (Mod+grave) — info general, tiempo, stats, acciones rápidas
(defwidget dashboard-widget []
  (box :class "panel dashboard" :orientation "v" :spacing 10
    (box :class "dash-header" :orientation "h" :space-evenly false :spacing 10
      (label :class "avatar" :text "󰄛")
      (box :orientation "v" :hexpand true :spacing 0
        (label :class "dash-name" :text "${user}")
        (label :class "dash-sub" :text "${host} · dwm"))
      (button :class "close" :onclick "${EWW_CMD} close dashboard" "󰅖"))
    (box :class "dash-time" :orientation "v" :spacing 0
      (label :class "clock" :text "${time}")
      (label :class "date" :text "${date}"))
    (box :class "dash-stats" :orientation "v" :spacing 8
      (statbar :icon "󰻠" :label "CPU" :value "${cpu.avg}" :color color-accent)
      (statbar :icon "󰍛" :label "RAM" :value "${ram.used_mem_perc}" :color color-accent-alt)
      (statbar :icon "󰋊" :label "DISK" :value "${disk['/'].used_perc}" :color color-yellow))
    (box :class "dash-actions" :orientation "h" :spacing 8
      (action :icon "󰆍" :command "kitty &")
      (action :icon "󰉋" :command "pcmanfm &")
      (action :icon "󰒓" :command "${EWW_CMD} open --toggle control"))
    (label :class "dash-foot" :text "uptime ${uptime} · ${updates} updates"))
)

;; Calendario
(defwidget calendar-widget []
  (box :class "panel calendar" :orientation "v" :spacing 8
    (box :class "cal-header" :orientation "h" :spacing 8
      (label :class "cal-time" :hexpand true :text "${time}")
      (button :class "close" :onclick "${EWW_CMD} close calendar" "󰅖"))
    (label :class "cal-long" :text "${longdate}")
    (calendar :class "cal-grid" :show-heading true :show-day-names true :show-week-numbers false)
    (label :class "cal-foot" :text "uptime ${uptime} · ${battery}"))
)

;; Centro de control (panel lateral derecho)
(defwidget control-widget []
  (box :class "panel control" :orientation "v" :spacing 10
    (box :class "cc-header" :orientation "h" :spacing 8
      (label :class "cc-title" :hexpand true :text "Centro de control")
      (button :class "close" :onclick "${EWW_CMD} close control" "󰅖"))
    
    ;; Toggles rápidos
    (box :class "cc-grid" :orientation "h" :spacing 8
      (tile :icon "󰤨" :label "WiFi" :command "nm-connection-editor &")
      (tile :icon "󰄀" :label "Captura" :command "flameshot gui")
      (tile :icon "󰌾" :label "Bloquear" :command "/usr/local/bin/dwm-safe lock")
      (tile :icon "󰛨" :label "No molestar" :command "dunstctl set-paused toggle"))
    
    ;; Estado rápido
    (label :class "cc-status" :text "WiFi ${wifi} · ${battery}")
    
    ;; Sliders
    (cc-slider :label "Volumen" :value "${volume}" :command "pamixer --set-volume {}")
    (cc-slider :label "Brillo" :value "${brightness}" :command "brightnessctl set {}%")
    
    ;; Acciones de energía
    (box :class "cc-actions" :orientation "h" :spacing 8
      (action :icon "󰐥" :command "/usr/local/bin/dwm-safe poweroff")
      (action :icon "󰜉" :command "/usr/local/bin/dwm-safe reboot")
      (action :icon "󰤄" :command "/usr/local/bin/dwm-safe suspend")
      (action :icon "󰍃" :command "/usr/local/bin/dwm-safe logout"))
)

;; Census (stats detalladas con gauges circulares)
(defwidget census-widget []
  (box :class "panel census" :orientation "v" :spacing 8
    (box :class "census-header" :orientation "h" :spacing 8
      (label :class "census-title" :hexpand true :text "CENSUS")
      (button :class "close" :onclick "${EWW_CMD} close census" "󰅖"))
    (box :class "census-grid" :orientation "v" :spacing 8
      (box :class "census-row" :orientation "h" :spacing 8
        (gauge :value "${temp}" :label "CPU TEMP" :icon "󰔏")
        (gauge :value "${ram.used_mem_perc}" :label "RAM" :icon "󰍛"))
      (box :class "census-row" :orientation "h" :spacing 8
        (gauge :value "${disk['/'].used_perc}" :label "DISK" :icon "󰋊")
        (gauge :value "${cpu.avg}" :label "CPU" :icon "󰻠"))
    )
    (box :class "census-foot" :orientation "v"
      (label :text "WiFi: ${wifi}")
      (label :text "Batería: ${battery}")
      (label :text "Uptime: ${uptime}"))
)
)

;; Power menu (Mod+Escape)
(defwidget power-widget []
  (box :class "panel power" :orientation "v" :spacing 8
    (box :class "power-header" :orientation "h" :spacing 8
      (label :class "power-title" :hexpand true :text "Energía")
      (button :class "close" :onclick "${EWW_CMD} close power" "󰅖"))
    (button :class "power-row" :onclick "/usr/local/bin/dwm-safe poweroff" "󰐥  Apagar")
    (button :class "power-row" :onclick "/usr/local/bin/dwm-safe reboot" "󰜉  Reiniciar")
    (button :class "power-row" :onclick "/usr/local/bin/dwm-safe lock" "󰌾  Bloquear")
    (button :class "power-row" :onclick "/usr/local/bin/dwm-safe suspend" "󰤄  Suspender")
    (button :class "power-row" :onclick "/usr/local/bin/dwm-safe logout" "󰍃  Cerrar sesión"))
)