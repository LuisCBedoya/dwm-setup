# Picom configuration for @THEME_NAME@ theme
# Generated from palette-@THEME_NAME@.sh — do not edit directly

backend = "glx";
vsync = true;

# Corner radius for rounded windows
corner-radius = 12;
rounded-corners-exclude = [
  "class_g = 'dwm'",
  "class_g = 'Dunst'",
  "window_type = 'dock'",
  "window_type = 'desktop'"
];

# Blur (dual_kawase)
blur-background = true;
blur-method = "dual_kawase";
blur-strength = 5;
blur-background-exclude = [
  "window_type = 'dock'",
  "window_type = 'desktop'",
  "class_g = 'Rofi'",
  "class_g = 'Eww'",
  "class_g = 'Dunst'"
];

# Shadows
shadow = true;
shadow-radius = 20;
shadow-opacity = 0.45;
shadow-color = "@COLOR_BG@";
shadow-exclude = [
  "class_g = 'dwm'",
  "class_g = 'Dunst'",
  "class_g = 'Rofi'",
  "class_g = 'Eww'",
  "_NET_WM_STATE@:32a *= '_NET_WM_STATE_HIDDEN'",
  "name = 'Notification'"
];

# Opacity rules
opacity-rule = [
  "96:class_g = 'Eww'",
  "100:class_g = 'dwm'",
  "90:class_g = 'Rofi'",
  "95:class_g = 'Dunst'"
];

# Fading
fading = true;
fade-in-step = 0.05;
fade-out-step = 0.05;
fade-delta = 5;

# Window frame opacity (for active/inactive)
frame-opacity = 0.9;
inactive-opacity = 0.95;
active-opacity = 1.0;

# Detect rounded corners
detect-rounded-corners = true;

# XSync
use-damage = true;
use-damage-pixmap = true;

# Refresh rate
refresh-rate = 0;

# XRender sync fence (avoid tearing)
xrender-sync-fence = true;

# GLX specific
glx-no-stencil = true;
glx-copy-from-front = false;
glx-use-copysubbuffermesa = true;

# VSync
vsync = true;

# Detect client opacity
detect-client-opacity = true;

# Window type settings
wintypes:
{
  tooltip = { fade = true; shadow = false; opacity = 0.9; };
  menu = { fade = true; shadow = true; opacity = 0.95; };
  dropdown_menu = { fade = true; shadow = true; opacity = 0.95; };
  popup_menu = { fade = true; shadow = true; opacity = 0.95; };
  fullscreen = { fade = false; shadow = false; opacity = 1.0; };
};