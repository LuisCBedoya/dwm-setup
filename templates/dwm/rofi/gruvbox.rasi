* {
    bg: #1e2122;
    bg-alt: #242728;
    fg: #c7b89d;
    fg-dim: #928374;
    accent: #89b482;
    urgent: #ec6b64;
    border: #3c3f41;
}

configuration {
    font: "JetBrainsMono Nerd Font 10";
    show-icons: true;
    icon-theme: "Adwaita";
    display-drun: "  ";
    drun-display-format: "{name}";
    disable-history: false;
}

window {
    width: 38%;
    border: 0;
    border-radius: 10;
    background-color: @bg;
    padding: 10;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 8;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 7;
    padding: 8;
    children: [prompt, entry];
    spacing: 6;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 9;
    spacing: 3;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 6;
    border-radius: 6;
    spacing: 8;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 20;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

message {
    background-color: @bg-alt;
    border-radius: 6;
    padding: 8;
}

textbox {
    text-color: @fg;
}
