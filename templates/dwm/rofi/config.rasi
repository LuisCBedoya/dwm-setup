/* Rofi configuration for dwm */
@import "colors.rasi"
@import "fonts.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Gruvbox-Material-Dark";
    terminal: "kitty";
    sidebar-mode: false;
    width: 500;
    lines: 10;
    columns: 1;
    fixed-num-lines: true;
    matching: "fuzzy";
    sort: true;
    sort-matching: "fzf";
    case-sensitive: false;
    cycle: true;
    scroll-method: 0;
    auto-select: false;
    parse-hosts: true;
    parse-known-hosts: true;
    combi-modi: "window,drun,run";
    theme-str: "
        window {
            location: center;
            anchor: center;
            fullscreen: false;
            width: 600;
            border: 2;
            border-radius: 12;
            padding: 20;
        }
        mainbox {
            spacing: 10;
        }
        inputbar {
            children: [prompt, entry];
            spacing: 10;
            padding: 10;
            border-radius: 8;
        }
        prompt {
            enabled: true;
            str: '󰍉';
            padding: 0 10 0 0;
        }
        entry {
            placeholder: 'Buscar...';
            padding: 8;
        }
        listview {
            spacing: 5;
            scrollbar: false;
            columns: 1;
            lines: 10;
        }
        element {
            padding: 8 12;
            border-radius: 6;
        }
        element-icon {
            size: 24;
            padding: 0 10 0 0;
        }
        element-text {
            vertical-align: 0.5;
        }
        element selected {
            background-color: @selected@;
        }
        element-text selected {
            text-color: @accent@;
        }
        element-icon selected {
            text-color: @accent@;
        }
    ";
}