/* Rofi colors: monolith (generado automáticamente) */
/* No editar directamente; modificar templates/colors/palette-monolith.sh */

* {
    /* Colores base */
    background:     #1d1d22;
    foreground:     #d8d4cc;
    selected:       #26262c;
    accent:         #b4a7d6;
    border:         #2b2b32;

    /* Estados */
    urgent:         #c97f7f;
    active:         #b4a7d6;
    normal:         #8a8a92;

    /* Transparencias */
    background-alpha: 0.95;
}
