; fan — modo del ventilador; clic para ciclar (se oculta sin soporte)
[module/fan]
type = custom/script
exec = @HOME@/.config/polybar/scripts/fan-mode.sh status
interval = 5
exec-if = /usr/local/bin/dwm-setup-fan-mode supported
format = <label>
format-padding = 1
format-background = ${colors.module-bg}
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
click-left = @HOME@/.config/polybar/scripts/fan-mode.sh cycle
