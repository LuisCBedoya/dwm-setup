; network — un solo indicador, comparte el script actual
[module/network]
type = custom/script
exec = @HOME@/.config/polybar/variants/reference/scripts/network-status.sh
interval = 5
format = <label>
format-padding = 0
format-background = ${colors.module-bg}
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
