; bluetooth — estado y conexión; clic para elegir dispositivo
[module/bluetooth]
type = custom/script
exec = @HOME@/.config/polybar/scripts/bluetooth-status.sh
interval = 10
exec-if = command -v bluetoothctl >/dev/null 2>&1
format = <label>
format-padding = 1
format-background = ${colors.module-bg}
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
click-left = @HOME@/.config/polybar/scripts/bluetooth-menu.sh
