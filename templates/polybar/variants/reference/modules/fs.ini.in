; fs — uso del SSD (raíz)
[module/fs]
type = internal/fs
interval = 30
mount-0 = /home
format-mounted = <label-mounted>
format-mounted-padding = 1
format-mounted-background = ${colors.module-bg}
format-mounted-foreground = ${colors.foreground}
label-mounted = "%{T1}%{F${colors.primary}}󰋊%{F-}%{T-} %percentage_used%%"
label-mounted-font = 1
format-unmounted =
label-unmounted =
