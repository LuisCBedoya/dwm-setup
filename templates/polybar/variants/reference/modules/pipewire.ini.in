; pipewire — volumen con máximo 120 % y pasos de 10 %
[module/pipewire]
type = custom/script
exec = @HOME@/.config/polybar/scripts/volume.sh status
interval = 1
exec-if = command -v pamixer >/dev/null 2>&1
format = <label>
format-padding = 1
format-background = ${colors.module-bg}
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
click-left = @HOME@/.config/polybar/scripts/volume.sh mute
click-right = pavucontrol
scroll-up = @HOME@/.config/polybar/scripts/volume.sh up
scroll-down = @HOME@/.config/polybar/scripts/volume.sh down
