; polypomo — pomodoro dentro del bloque izquierdo
[module/polypomo]
type = custom/script
exec = @HOME@/.config/polybar/scripts/polypomo
tail = true
format = "%{T1}<label>"
format-padding = 1
format-background = ${colors.module-bg}
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
click-left = @HOME@/.config/polybar/scripts/polypomo toggle
click-right = @HOME@/.config/polybar/scripts/polypomo end
click-middle = @HOME@/.config/polybar/scripts/polypomo lock
scroll-up = @HOME@/.config/polybar/scripts/polypomo time +120
scroll-down = @HOME@/.config/polybar/scripts/polypomo time -120
