#!/bin/sh
# network-status.sh — un solo indicador de red (Ethernet > WiFi)
# Sin conexión muestra NoC; nunca muestra el SSID.
# NETWORK_FAKE=wifi|eth|none permite probar los tres estados sin tocar la red.

LC_ALL=C
export LC_ALL

wifi=0
eth=0

if command -v nmcli >/dev/null 2>&1; then
  status=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null) || status=
  if printf '%s\n' "$status" | awk -F: '$2=="wifi" && $3 ~ /^connected/ {found=1} END {exit !found}'; then
    wifi=1
  fi
  if printf '%s\n' "$status" | awk -F: '$2=="ethernet" && $3 ~ /^connected/ {found=1} END {exit !found}'; then
    eth=1
  fi
fi

# Fallback para interfaces que NetworkManager no gestiona o si falta nmcli.
if [ "$wifi" -eq 0 ] && [ -n "@WLAN_IFACE@" ] && [ -r "/sys/class/net/@WLAN_IFACE@/carrier" ]; then
  [ "$(cat "/sys/class/net/@WLAN_IFACE@/carrier" 2>/dev/null)" = "1" ] && wifi=1
fi
if [ "$eth" -eq 0 ] && [ -n "@ETH_IFACE@" ] && [ -r "/sys/class/net/@ETH_IFACE@/carrier" ]; then
  [ "$(cat "/sys/class/net/@ETH_IFACE@/carrier" 2>/dev/null)" = "1" ] && eth=1
fi

case ${NETWORK_FAKE:-} in
  wifi) wifi=1; eth=0 ;;
  eth) wifi=0; eth=1 ;;
  both) wifi=1; eth=1 ;;
  none) wifi=0; eth=0 ;;
esac

if [ "$eth" -eq 1 ]; then
  printf '%%{T1}󰈀 %%{T-}connected\n'
elif [ "$wifi" -eq 1 ]; then
  printf '%%{T1}󰖩 %%{T-}connected\n'
else
  printf '%%{T1}󰖩 %%{T-}NoC\n'
fi
