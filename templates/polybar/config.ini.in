; polybar config.ini — generado desde template, no editar directamente
; Paleta exacta del screenshot (Warm Charcoal)
; Barra TOP, full-width, sin subrayados, sin bloques de fondo

include-directory = @HOME@/.config/polybar/modules

[colors]
background = #18181A
background-alt = #202022
foreground = #D8D3CC
foreground-alt = #8E8A85
primary = #B9A99A
secondary = #8FA6B4
alert = #C97A6D
disabled = #5E5E62

; Alias para módulos portados
nord0 = #18181A
nord1 = #202022
nord2 = #2A2A2C
nord3 = #35353A
nord4 = #D8D3CC
nord5 = #8E8A85
nord6 = #E6E1DA
nord7 = #8FA6B4
nord8 = #A7BAC7
nord9 = #B9A99A
nord10 = #6E8494
nord11 = #C97A6D
nord12 = #C9B18C
nord13 = #D6C1A0
nord14 = #A8BFAE
nord15 = #A99BB0

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = 20
radius = 0
bottom = false
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 0
line-color = ${colors.background}

border-size = 0
border-color = ${colors.background}

padding-left = 0
padding-right = 0

module-margin-left = 0
module-margin-right = 0

font-0 = "@FONT@:style=SemiBold:size=11;3"
font-1 = "@FONT@:style=SemiBold:size=10;3"
font-2 = "@FONT@:style=Bold:size=10;3"
font-3 = "@FONT@:size=13;3"
font-4 = "@FONT@:size=11;5"
font-5 = "Noto Color Emoji:scale=9:antialias=false;3"

modules-left = logo bspwm
modules-right = updates services polypomo temp memory cpu network pipewire @BATTERY_MODULE@ date

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

wm-restack = bspwm

override-redirect = true

[settings]
screenchange-reload = true
pseudo-transparency = true

; vim:ft=dosini
