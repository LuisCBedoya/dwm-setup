; polybar config.ini — generado desde template, no editar directamente
; Paleta exacta del screenshot (Warm Charcoal)
; Barra TOP, full-width, sin subrayados, sin bloques de fondo

include-directory = @HOME@/.config/polybar/modules

[colors]
background = @COLOR_BG@
background-alt = @COLOR_BG_ALT@
foreground = @COLOR_FG@
foreground-alt = @COLOR_FG_MUTED@
primary = @COLOR_ACCENT@
secondary = @COLOR_ACCENT_ALT@
alert = @COLOR_RED@
disabled = @COLOR_FG_DIM@
selected = @COLOR_FG@

; Alias para módulos portados
nord0 = @COLOR_BG@
nord1 = @COLOR_BG_ALT@
nord2 = @COLOR_BG_ELEV@
nord3 = @COLOR_BG_HOVER@
nord4 = @COLOR_FG@
nord5 = @COLOR_FG_MUTED@
nord6 = @COLOR_ACCENT_ALT@
nord7 = @COLOR_ACCENT@
nord8 = @COLOR_CYAN@
nord9 = @COLOR_ACCENT@
nord10 = @COLOR_CYAN@
nord11 = @COLOR_RED@
nord12 = @COLOR_YELLOW@
nord13 = @COLOR_ORANGE@
nord14 = @COLOR_GREEN@
nord15 = @COLOR_PURPLE@

[bar/main]
monitor = ${env:MONITOR:}
width = 100%
height = @BAR_HEIGHT@
radius = 0
bottom = ${env:POLYBAR_BOTTOM:false}
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 0
line-color = ${colors.background}

border-size = 0
border-color = ${colors.background}

padding-left = 0
padding-right = 0

module-margin-left = 0
module-margin-right = 0

font-0 = "@FONT@:style=SemiBold:size=11;3"
font-1 = "@FONT@:style=SemiBold:size=10;3"
font-2 = "@FONT@:style=Bold:size=10;3"
font-3 = "@FONT@:size=13;3"
font-4 = "@FONT@:size=11;5"
font-5 = "Noto Color Emoji:scale=9:antialias=false;3"

modules-left = logo bspwm monocle
modules-right = updates services polypomo temp memory cpu network pipewire @BRIGHTNESS_MODULE@ @BATTERY_MODULE@ date

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

wm-restack = bspwm

override-redirect = true

[settings]
screenchange-reload = true
pseudo-transparency = true

; vim:ft=dosini
