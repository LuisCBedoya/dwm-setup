#!/bin/sh
# polybar-variant — cambia entre las dos variantes de la barra
set -eu

case "${1:-}" in
  actual|referencia) variant="$1" ;;
  toggle)
    current=$(cat "@HOME@/.config/polybar/variant" 2>/dev/null || true)
    if [ "$current" = "referencia" ]; then
      variant="actual"
    else
      variant="referencia"
    fi
    ;;
  *)
    printf 'Uso: %s actual|referencia|toggle\n' "$0" >&2
    exit 1
    ;;
esac

printf '%s\n' "$variant" > "@HOME@/.config/polybar/variant"
exec "@HOME@/.config/polybar/launch.sh"
