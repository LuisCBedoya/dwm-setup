#!/bin/sh
# fan-mode.sh — módulo de ventilador para polybar (estado y clic).
# Estados: auto (lo gestiona dwm-setup-fan-auto) o manual:<modo>.
# Un clic cicla: auto -> normal -> overboost -> silent -> auto.
set -u

HELPER=${DWM_SETUP_FAN_HELPER:-/usr/local/bin/dwm-setup-fan-mode}
AUTO=${DWM_SETUP_FAN_AUTO:-$HOME/.local/bin/dwm-setup-fan-auto}
NOTIFY=${DWM_SETUP_NOTIFY:-notify-send}
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-setup
STATE=$CONF_DIR/fan-mode
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/dwm-setup
EFFECTIVE=$CACHE_DIR/fan-effective

ACCENT='@COLOR_BAR_ACCENT@'
GREEN='@COLOR_GREEN@'

ICON_FAN="󰈐 "      # U+F0210 fan
ICON_FAST="󰢚 "     # U+F089A alien
ICON_SILENT="󰜗 "   # U+F0717 snowflake

notify() {
  command -v "$NOTIFY" >/dev/null 2>&1 || return 0
  "$NOTIFY" "$@" >/dev/null 2>&1 || true
}

[ -x "$HELPER" ] || exit 1
"$HELPER" supported >/dev/null 2>&1 || exit 1

read_state() { cat "$STATE" 2>/dev/null || printf 'auto'; }

print_mode() {
  case "$1" in
    overboost|performance)
      printf '%%{F%s}%%{T3}%s%%{T-}%s%%{F-}\n' "$ACCENT" "$ICON_FAST" "$2"
      ;;
    silent|quiet)
      printf '%%{F%s}%%{T3}%s%%{T-}%s%%{F-}\n' "$GREEN" "$ICON_SILENT" "$2"
      ;;
    *)
      printf '%%{T3}%s%%{T-}%s\n' "$ICON_FAN" "$2"
      ;;
  esac
}

case "${1:-status}" in
  status)
    st=$(read_state)
    case "$st" in
      auto)
        # El modo real manda (el EC o Fn+F5 pueden cambiarlo sin pasar por aquí).
        eff=$("$HELPER" status 2>/dev/null || cat "$EFFECTIVE" 2>/dev/null || printf 'normal')
        print_mode "$eff" "auto: $eff"
        ;;
      manual:*)
        m=${st#manual:}
        print_mode "$m" "$m"
        ;;
      *)
        printf 'auto\n'
        ;;
    esac
    ;;
  cycle)
    st=$(read_state)
    case "$st" in
      auto) next=manual:normal ;;
      manual:normal) next=manual:overboost ;;
      manual:overboost) next=manual:silent ;;
      manual:silent) next=auto ;;
      *) next=auto ;;
    esac
    mkdir -p "$CONF_DIR" 2>/dev/null || true
    printf '%s\n' "$next" >"$STATE" 2>/dev/null || exit 1
    if [ "$next" = auto ]; then
      [ -x "$AUTO" ] && "$AUTO" --once >/dev/null 2>&1 || true
      eff=$(cat "$EFFECTIVE" 2>/dev/null || printf 'normal')
      notify -a "dwm-setup" -i "preferences-system" "Ventilador: auto" "El sistema decide ($eff)"
    else
      m=${next#manual:}
      if sudo -n "$HELPER" set "$m" >/dev/null 2>&1; then
        mkdir -p "$CACHE_DIR" 2>/dev/null || true
        printf '%s\n' "$m" >"$EFFECTIVE" 2>/dev/null || true
        notify -a "dwm-setup" -i "preferences-system" "Ventilador: $m" "Modo manual"
      else
        notify -a "dwm-setup" -i "dialog-warning" "Ventilador" "No se pudo cambiar el modo"
        exit 1
      fi
    fi
    ;;
  *)
    exit 2
    ;;
esac
