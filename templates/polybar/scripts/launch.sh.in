#!/bin/bash
# polybar launch.sh — generado desde template
# Detecta hardware y lanza polybar con la config ya final (sin sed runtime)

set -eu

killall -q polybar
while pgrep -u "$UID" -x polybar >/dev/null; do sleep 0.1; done

CONFIG="@HOME@/.config/polybar/config.ini"

polybar -r main -c "$CONFIG" &

echo "Polybar iniciado"