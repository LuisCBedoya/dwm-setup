#!/bin/bash
# polybar launch.sh — generado desde template
# Lanza polybar con la config ya renderizada (sin detección en runtime)

set -eu

pkill -x polybar 2>/dev/null || true
tries=0
while pgrep -u "$UID" -x polybar >/dev/null; do
  tries=$((tries + 1))
  if [ "$tries" -ge 20 ]; then
    pkill -9 -u "$UID" -x polybar 2>/dev/null || true
    break
  fi
  sleep 0.1
done

variant="actual"
if [ -r "@HOME@/.config/polybar/variant" ]; then
  variant=$(cat "@HOME@/.config/polybar/variant" 2>/dev/null || printf 'actual')
fi

position="top"
if [ -r "@HOME@/.config/polybar/position" ]; then
  position=$(cat "@HOME@/.config/polybar/position" 2>/dev/null || printf 'top')
fi
case "$position" in
  bottom) POLYBAR_BOTTOM=true ;;
  *) POLYBAR_BOTTOM=false ;;
esac
export POLYBAR_BOTTOM

if command -v bspc >/dev/null 2>&1; then
  case "$position" in
    bottom)
      bspc config top_padding 0 || true
      bspc config bottom_padding 26 || true
      ;;
    *)
      bspc config top_padding 26 || true
      bspc config bottom_padding 0 || true
      ;;
  esac
fi

case "$variant" in
  referencia)
    CONFIG="@HOME@/.config/polybar/variants/reference/config.ini"
    ;;
  *)
    CONFIG="@HOME@/.config/polybar/config.ini"
    ;;
esac

polybar -r main -c "$CONFIG" &

echo "Polybar iniciado"
