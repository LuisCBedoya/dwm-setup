#!/bin/bash
# polybar launch.sh — generado desde template
# Lanza polybar con la config ya renderizada (sin detección en runtime)

set -eu

# Serializa los reinicios: dos launch.sh a la vez pueden matarse entre sí.
LOCK="${XDG_RUNTIME_DIR:-$HOME/.cache}/polybar-launch.lock"
exec 9>"$LOCK" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
  flock -w 10 9 || exit 0
fi

# Scripts tail=true de polybar que, si quedan huérfanos, retienen el
# socket de bspwm y pueden bloquear el gestor de ventanas.
cleanup_polybar_orphans() {
  local p pgid
  for p in $(pgrep -x updates-apt.sh 2>/dev/null || true) \
           $(pgrep -x polypomo 2>/dev/null || true); do
    pgid=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')
    if [ -n "$pgid" ]; then
      kill -TERM -"$pgid" 2>/dev/null || kill "$p" 2>/dev/null || true
    else
      kill "$p" 2>/dev/null || true
    fi
  done
}

pkill -x polybar 2>/dev/null || true
tries=0
while pgrep -u "$UID" -x polybar >/dev/null; do
  tries=$((tries + 1))
  if [ "$tries" -ge 20 ]; then
    pkill -9 -u "$UID" -x polybar 2>/dev/null || true
    break
  fi
  sleep 0.1
done

cleanup_polybar_orphans

variant="actual"
if [ -r "@HOME@/.config/polybar/variant" ]; then
  variant=$(cat "@HOME@/.config/polybar/variant" 2>/dev/null || printf 'actual')
fi

position="top"
if [ -r "@HOME@/.config/polybar/position" ]; then
  position=$(cat "@HOME@/.config/polybar/position" 2>/dev/null || printf 'top')
fi
case "$position" in
  bottom) POLYBAR_BOTTOM=true ;;
  *) POLYBAR_BOTTOM=false ;;
esac
export POLYBAR_BOTTOM

if command -v bspc >/dev/null 2>&1; then
  case "$position" in
    bottom)
      bspc config top_padding 0 || true
      bspc config bottom_padding @BAR_HEIGHT@ || true
      ;;
    *)
      bspc config top_padding @BAR_HEIGHT@ || true
      bspc config bottom_padding 0 || true
      ;;
  esac
fi

if [ -x "$HOME/.config/bspwm/scripts/dunst-position.sh" ]; then
  "$HOME/.config/bspwm/scripts/dunst-position.sh" 2>/dev/null || true
fi

case "$variant" in
  referencia)
    CONFIG="@HOME@/.config/polybar/variants/reference/config.ini"
    ;;
  *)
    CONFIG="@HOME@/.config/polybar/config.ini"
    ;;
esac

# El lock no debe heredarse: polybar y sus scripts lo retendrían.
exec 9>&-
polybar -r main -c "$CONFIG" &

echo "Polybar iniciado"
