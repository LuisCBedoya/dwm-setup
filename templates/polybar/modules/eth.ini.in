; eth — red cableada
[module/eth]
type = internal/network
interface = @ETH_IFACE@
interval = 10.0
format-connected = <label-connected>
format-connected-padding = 3
format-connected-foreground = ${colors.foreground}
label-connected = "%{T1}󰈀 %{T-} connected"
label-connected-font = 1

format-disconnected =
label-disconnected =
