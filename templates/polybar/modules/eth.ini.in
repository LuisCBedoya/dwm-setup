; eth — red cableada
[module/eth]
type = internal/network
interface = @ETH_IFACE@
interval = 10.0
format-connected = <label-connected>
format-connected-padding = 6
format-connected-foreground = ${colors.foreground}
label-connected = "\uf6ff connected"
label-connected-font = 0

format-disconnected =
label-disconnected =