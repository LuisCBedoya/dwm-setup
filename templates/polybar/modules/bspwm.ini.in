; bspwm — workspaces 1-5 con dígitos árabes, solo el enfocado tiene caja clara
[module/bspwm]
type = internal/bspwm

label-focused = %name%
label-focused-background = #C9D1D9
label-focused-foreground = #0D1117
label-focused-padding = 2
label-focused-font = 3

label-occupied = %name%
label-occupied-foreground = ${colors.foreground}
label-occupied-padding = 2
label-occupied-font = 3

label-urgent = %name%
label-urgent-foreground = ${colors.alert}
label-urgent-padding = 2
label-urgent-font = 3

label-empty = %name%
label-empty-foreground = ${colors.disabled}
label-empty-padding = 2
label-empty-font = 3
