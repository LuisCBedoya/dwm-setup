; temp — temperatura CPU con rampa de iconos
[module/temp]
type = internal/temperature
thermal-zone = 0
warn-temperature = 75
format = <ramp><label>
format-padding = 2
format-foreground = ${colors.foreground}
label = %temperature-c% [T]
label-font = 1
ramp-0 = "%{T1}%{T-} "
ramp-1 = "%{T1}%{T-} "
ramp-2 = "%{T1}%{T-} "
ramp-foreground = ${colors.foreground}
