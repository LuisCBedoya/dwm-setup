; network — un solo indicador: Ethernet > WiFi; sin NoC
[module/network]
type = custom/script
exec = @HOME@/.config/polybar/scripts/network-status.sh
interval = 5
format = <label>
format-padding = 0
format-font = 1
format-foreground = ${colors.foreground}
label = %output%
click-left = @HOME@/.config/polybar/scripts/network-menu.sh
