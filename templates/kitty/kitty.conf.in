# kitty.conf — generado desde template
# Paleta: @THEME_NAME@ (Warm Charcoal)

font_family      @FONT@
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        @FONT_SIZE@

# UI
window_padding_width    10
window_margin_width     5
window_border_width     1
window_min_width        10
window_min_height       10
hide_window_decorations no
decorations             full

# Tabs
tab_bar_style           powerline
tab_bar_edge            bottom
tab_bar_min_tabs        1
tab_bar_margin          0
tab_powerline_style     slanted
tab_activity_symbol     ●
tab_inactive_text_alpha 0.5

# Colorscheme Warm Charcoal
# Polar Night
background              @COLOR_BG@
background_opacity      1.0
dynamic_background_opacity no
foreground              @COLOR_FG@
selection_background    @COLOR_BG_ELEV@
selection_foreground    @COLOR_FG@

# Cursor
cursor                  @COLOR_ACCENT@
cursor_text_color       @COLOR_BG@

# URL
url_color               @COLOR_ACCENT_ALT@

# Tabs
active_tab_background   @COLOR_ACCENT@
active_tab_foreground   @COLOR_BG@
inactive_tab_background @COLOR_BG_ALT@
inactive_tab_foreground @COLOR_FG_MUTED@
tab_bar_background      @COLOR_BG@

# Border
window_border_color     @COLOR_BORDER@
active_border_color     @COLOR_ACCENT@
inactive_border_color   @COLOR_BG_ALT@
bell_border_color       @COLOR_YELLOW@

# ANSI colors (Warm Charcoal)
# Black
color0  @COLOR_BG@
color8  @COLOR_FG_MUTED@
# Red
color1  @COLOR_RED@
color9  @COLOR_RED@
# Green
color2  @COLOR_GREEN@
color10 @COLOR_GREEN@
# Yellow
color3  @COLOR_YELLOW@
color11 @COLOR_YELLOW@
# Blue
color4  @COLOR_BLUE@
color12 @COLOR_BLUE@
# Magenta
color5  @COLOR_PURPLE@
color13 @COLOR_PURPLE@
# Cyan
color6  @COLOR_CYAN@
color14 @COLOR_CYAN@
# White
color7  @COLOR_FG@
color15 @COLOR_FG@

# Scrollback
scrollback_lines        10000
scrollback_pager        less
scrollback_fill_enlarged_window yes

# Keyboard
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map ctrl+shift+enter new_window_with_cwd
map ctrl+shift+t new_tab_with_cwd
map ctrl+left  neighboring_window left
map ctrl+right neighboring_window right
map ctrl+up    neighboring_window up
map ctrl+down  neighboring_window down
map kitty_mod+left  move_window_left
map kitty_mod+right move_window_right
map kitty_mod+up    move_window_up
map kitty_mod+down  move_window_down

# Startup
shell_integration     no-curse
wayland_titlebar_color system

# Performance
repaint_delay         10
input_delay           3
sync_to_monitor       yes