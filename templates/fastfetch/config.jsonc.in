{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
         "type": "kitty",
         "source": "@HOME@/.config/fastfetch/Neofet.png",
         "width": 24,
         "height": 13
     },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom", // HardwareStart
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "{#38;2;@COLOR_FG_DIM_RGB@}╭─────────── {#1;38;2;@COLOR_ACCENT_ALT_RGB@}Hardware Information{#38;2;@COLOR_FG_DIM_RGB@} ────────────────────┐"
        },
        {
            "type": "cpu",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}CPU"
        },
        {
            "type": "gpu",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}GPU"
        },
        {
            "type": "memory",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}RAM"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "{#38;2;@COLOR_FG_DIM_RGB@}├─────────── {#1;38;2;@COLOR_ACCENT_ALT_RGB@}Software Information{#38;2;@COLOR_FG_DIM_RGB@} ───────────┤"
        },
        {
            "type": "os",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}System"
        },
        {
            "type": "kernel",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Kernel",
            "format": "{1} {2}"
        },
        {
            "type": "de",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Desktop"
        },
        {
            "type": "terminal",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Terminal"
        },
        {
            "type": "packages",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@}󰏔 {#1;38;2;@COLOR_ACCENT_RGB@}Packages"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "{#38;2;@COLOR_FG_DIM_RGB@}├─────────── {#1;38;2;@COLOR_ACCENT_ALT_RGB@}Theme Details{#38;2;@COLOR_FG_DIM_RGB@} ──────────────────┤"
        },
        {
            "type": "theme",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Desktop Theme"
        },
        {
            "type": "wmtheme",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Window Theme"
        },
        {
            "type": "icons",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@}󰔎 {#1;38;2;@COLOR_ACCENT_RGB@}Icon Theme"
        },
        {
            "type": "shell",
            "key": "{#38;2;@COLOR_FG_DIM_RGB@}│ {#1;38;2;@COLOR_ACCENT_ALT_RGB@} {#1;38;2;@COLOR_ACCENT_RGB@}Current Shell"
        },
        {
            "type": "custom", // InformationEnd
            "format": "{#38;2;@COLOR_FG_DIM_RGB@}╰──────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom", // Colours
            "format": " {#1;30} {#1;31} {#1;33} {#1;32} {#1;36} {#1;34} {#1;35} {#1;37} "
        },
    ]
}
