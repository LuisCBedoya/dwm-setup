{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
         "type": "kitty",
         "source": "@HOME@/.config/fastfetch/Neofet.png",
         "width": 24,
         "height": 13
     },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom", // HardwareStart
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "╭─────────── {#1;31}Hardware Information{#} ────────────────────┐"
        },
        {
            "type": "cpu",
            "key": "{#}│ {#1;36} {#1;35}CPU"
        },
        {
            "type": "gpu",
            "key": "{#}│ {#1;36} {#1;38}GPU"
        },
        {
            "type": "memory",
            "key": "{#}│ {#1;36} {#1;32}RAM"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "├─────────── {#1;31}Software Information{#} ───────────┤"
        },
        {
            "type": "os",
            "key": "{#}│ {#1;36} {#1;34}System"
        },
        {
            "type": "kernel",
            "key": "{#}│ {#1;36} {#1;35}Kernel",
            "format": "{1} {2}"
        },
        {
            "type": "de",
            "key": "{#}│ {#1;36} {#1;38}Desktop"
        },
        {
            "type": "terminal",
            "key": "{#}│ {#1;36} {#1;35}Terminal"
        },
        {
            "type": "packages",
            "key": "{#}│ {#1;36}󰏔 {#1;34}Packages"
        },
        {
            "type": "custom", // SoftwareStart
            "format": "├─────────── {#1;31}Theme Details{#} ──────────────────┤"
        },
        {
            "type": "theme",
            "key": "{#}│ {#1;36} {#1;33}Desktop Theme"
        },
        {
            "type": "wmtheme",
            "key": "{#}│ {#1;36} {#1;37}Window Theme"
        },
        {
            "type": "icons",
            "key": "{#}│ {#1;36}󰔎 {#1;35}Icon Theme"
        },
        {
            "type": "shell",
            "key": "{#}│ {#1;36} {#1;30}Current Shell"
        },
        {
            "type": "custom", // InformationEnd
            "format": "╰──────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom", // Colours
            "format": " {#1;30} {#1;31} {#1;33} {#1;32} {#1;36} {#1;34} {#1;35} {#1;37} "
        },
    ]
}
