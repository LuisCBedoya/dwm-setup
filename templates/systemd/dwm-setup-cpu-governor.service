[Unit]
Description=dwm-setup: gobernador de CPU por defecto (performance)
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dwm-setup-cpu-governor performance
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
