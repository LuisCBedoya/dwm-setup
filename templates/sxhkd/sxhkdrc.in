# sxhkdrc — generado desde template, no editar directamente
# Paleta: @THEME_NAME@ (Warm Charcoal)
# Mapa basado en los atajos de i3 del usuario.

# ─── Aplicaciones (mapa de i3) ───
super + Return
    @TERM@

super + d
    @MENU@

super + shift + d
    rofi -show run

super + shift + b
    @BROWSER@

super + shift + v
    @EDITOR@

super + shift + p
    pcmanfm

super + shift + i
    ristretto

super + shift + a
    lxappearance

super + shift + s
    @HOME@/.config/bspwm/scripts/screenshot_region.sh

super + shift + f
    @FILEMGR@

super + shift + l
    @LOCK@

super + shift + e
    /usr/local/bin/desktop-safe logout

Print
    @HOME@/.config/bspwm/scripts/screenshot_full.sh
super + Print
    @SCREENSHOT@

# ─── Sistema ───
super + alt + q
    bspc quit
super + alt + r
    bspc wm -r
# Alternar variante de polybar (A/B)
super + alt + p
    @HOME@/.config/polybar/polybar-variant toggle
super + shift + c
    pkill -USR1 -x sxhkd; bspc wm -r
super + shift + r
    bspc wm -r

# Cerrar ventana
super + q
    bspc node -c
super + shift + q
    bspc node -c

# ─── Estados de ventana ───
# Alternar monocle / tiled
super + m
    bspc desktop -l next

super + t
    bspc node -t tiled
super + shift + t
    bspc node -t pseudo_tiled
super + s
    bspc node -t floating
super + shift + space
    bspc node -t ~floating
super + f
    bspc node -t ~fullscreen
super + a
    bspc node -f @parent

# Split horizontal / vertical (preselección para la próxima ventana)
super + b
    bspc node -p ~east
super + v
    bspc node -p ~south

# Flags de ventana
super + ctrl + m
    bspc node -g marked
super + ctrl + x
    bspc node -g locked
super + ctrl + y
    bspc node -g sticky
super + ctrl + z
    bspc node -g private

# ─── Foco y movimiento ───
# Direcciones
super + {_,shift + }{h,j,k,l}
    bspc node -{f,s} {west,south,north,east}

# Alt+Tab: ciclo de ventanas del escritorio actual
alt + Tab
    bspc node -f next.local.!hidden.window
alt + shift + Tab
    bspc node -f prev.local.!hidden.window

# Ventana siguiente/anterior
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Escritorios (5)
super + bracket{left,right}
    bspc desktop -f {prev,next}.local
super + {_,shift + }{1-5}
    bspc {desktop -f,node -d} '^{1-5}'

# ─── Redimensionar: Super+r y luego h/j/k/l ───
# Con ':' la cadena sigue activa tras la cola; Escape sale.
super + r : h
    @HOME@/.config/bspwm/scripts/bspwm_resize h
super + r : j
    @HOME@/.config/bspwm/scripts/bspwm_resize j
super + r : k
    @HOME@/.config/bspwm/scripts/bspwm_resize k
super + r : l
    @HOME@/.config/bspwm/scripts/bspwm_resize l

# Mover ventana flotante
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# ─── Multimedia ───
XF86AudioRaiseVolume
    pamixer -i 5
XF86AudioLowerVolume
    pamixer -d 5
XF86AudioMute
    pamixer -t

XF86MonBrightnessUp
    brightnessctl set +10%
XF86MonBrightnessDown
    brightnessctl set 10%-

# Fallback F-keys
F2
    pamixer -i 5
F1
    pamixer -d 5
F3
    pamixer -t
F12
    brightnessctl set +10%
F11
    brightnessctl set 10%-

# ─── Recargar configs ───
super + ctrl + r
    pkill -USR1 -x sxhkd; bspc wm -r
