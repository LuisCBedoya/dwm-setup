# sxhkdrc — generado desde template, no editar directamente
# Paleta: @THEME_NAME@
# Mapa basado en los atajos de i3 del usuario.

# ─── Aplicaciones (mapa de i3) ───
super + Return
    @TERM@

super + d
    @MENU@

super + shift + d
    rofi -show run

super + shift + b
    @BROWSER@

super + shift + v
    @EDITOR@

super + shift + p
    pcmanfm

super + shift + i
    ristretto

super + shift + a
    lxappearance

super + shift + s
    @HOME@/.config/bspwm/scripts/screenshot_region.sh

super + shift + f
    @FILEMGR@

super + shift + l
    @LOCK@

super + shift + e
    /usr/local/bin/desktop-safe logout

Print
    @HOME@/.config/bspwm/scripts/screenshot_full.sh
super + Print
    @SCREENSHOT@

# ─── Sistema ───
super + alt + q
    bspc quit
super + alt + r
    bspc wm -r
# Alternar variante de polybar (A/B)
super + alt + p
    @HOME@/.config/polybar/polybar-variant cycle
# Alternar wallpaper principal / alternativo
super + alt + w
    @HOME@/.config/bspwm/scripts/wallpaper.sh toggle
# Alternar tema claro/oscuro (Catppuccin Mocha Black / Latte)
super + alt + t
    /usr/local/bin/theme-mode toggle
super + shift + c
    pkill -USR1 -x sxhkd; bspc wm -r
super + shift + r
    bspc wm -r

# Cerrar ventana
super + q
    bspc node -c
super + shift + q
    bspc node -c

# ─── Estados de ventana ───
# Alternar monocle / tiled
super + m
    @HOME@/.config/bspwm/scripts/monocle.sh

super + t
    bspc node -t tiled
super + shift + t
    bspc node -t pseudo_tiled
super + s
    bspc node -t floating
# Alternar flotante/tiled. Los ~ van entre comillas: sxhkd usa zsh.
super + shift + space
    bspc node -t '~floating'
ctrl + space
    bspc node -t '~floating'
super + f
    bspc node -t '~fullscreen'
super + a
    bspc node -f @parent

# Split horizontal / vertical (preselección para la próxima ventana)
super + b
    bspc node -p '~east'
super + v
    bspc node -p '~south'

# Flags de ventana
super + ctrl + m
    bspc node -g marked
super + ctrl + x
    bspc node -g locked
super + ctrl + y
    bspc node -g sticky
super + ctrl + z
    bspc node -g private

# ─── Foco y ciclo de ventanas ───
# ADR-112: sin Super+h/j/k/l (ni su versión Shift); el ciclo es Alt+Tab
# y next/prev con Super+c.

# Alt+Tab: ciclo de ventanas del escritorio actual
alt + Tab
    bspc node -f next.local.!hidden.window
alt + shift + Tab
    bspc node -f prev.local.!hidden.window

# Ventana siguiente/anterior
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window

# Escritorios dinámicos (ADR-112): se crean al saltar y se borran
# vacíos al salir de ellos; workspace.sh usa nombres, no posiciones
# (con huecos, '^N' apuntaría a otra cosa).
ctrl + Tab
    @HOME@/.config/bspwm/scripts/workspace.sh next
ctrl + shift + Tab
    @HOME@/.config/bspwm/scripts/workspace.sh prev
super + ctrl + Tab
    bspc desktop -f next.local
super + ctrl + shift + Tab
    bspc desktop -f prev.local
super + bracket{left,right}
    bspc desktop -f {prev,next}.local
super + {1-7}
    @HOME@/.config/bspwm/scripts/workspace.sh focus {1-7}
super + shift + {1-7}
    @HOME@/.config/bspwm/scripts/workspace.sh move {1-7}

# ─── Modo resize: Super+r, luego h/j/k/l; Escape o 6 s sale ───
# resize-mode.sh arranca un sxhkd hijo que solo captura h/j/k/l/Escape.
super + r
    @HOME@/.config/bspwm/scripts/resize-mode.sh start

# Mover ventana flotante
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# ─── Multimedia ───
XF86AudioRaiseVolume
    @HOME@/.config/polybar/scripts/volume.sh up
XF86AudioLowerVolume
    @HOME@/.config/polybar/scripts/volume.sh down
XF86AudioMute
    @HOME@/.config/polybar/scripts/volume.sh mute
XF86AudioPlay
    /usr/local/bin/music-ctl play-pause
XF86AudioNext
    /usr/local/bin/music-ctl next
XF86AudioPrev
    /usr/local/bin/music-ctl prev
XF86AudioStop
    /usr/local/bin/music-ctl stop
XF86AudioForward
    /usr/local/bin/music-ctl forward
XF86AudioRewind
    /usr/local/bin/music-ctl backward

XF86MonBrightnessUp
    brightnessctl set +10%
XF86MonBrightnessDown
    brightnessctl set 10%-

# Fallback F-keys
F2
    @HOME@/.config/polybar/scripts/volume.sh up
F1
    @HOME@/.config/polybar/scripts/volume.sh down
F3
    @HOME@/.config/polybar/scripts/volume.sh mute
F12
    brightnessctl set +10%
F11
    brightnessctl set 10%-

# ─── Recargar configs ───
super + ctrl + r
    pkill -USR1 -x sxhkd; bspc wm -r
