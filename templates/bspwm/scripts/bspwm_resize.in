#!/bin/sh
# bspwm_resize — resize tipo i3
# Uso: bspwm_resize {h|j|k|l} [paso]
#   h: encoger ancho
#   j: encoger alto
#   k: agrandar alto
#   l: agrandar ancho

direction="${1:-}"
step="${2:-20}"

resize_mode="$HOME/.config/bspwm/scripts/resize-mode.sh"
[ -x "$resize_mode" ] && "$resize_mode" touch >/dev/null 2>&1 || true

case "$direction" in
  h) bspc node -z right "$step" 0 || bspc node -z left -"$step" 0 ;;
  j) bspc node -z bottom 0 -"$step" || bspc node -z top 0 "$step" ;;
  k) bspc node -z bottom 0 "$step" || bspc node -z top 0 -"$step" ;;
  l) bspc node -z right -"$step" 0 || bspc node -z left "$step" 0 ;;
  *)
    printf 'Uso: %s {h|j|k|l} [paso]\n' "$0" >&2
    exit 1
    ;;
esac
