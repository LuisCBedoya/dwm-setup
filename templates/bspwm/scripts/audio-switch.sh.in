#!/bin/sh
# audio-switch.sh — cambia la salida y la entrada de audio según el hardware.
# Uso: audio-switch.sh [auto|headphones|usb|bluetooth|hdmi|analog]
#
# Prioridad: jack > USB > Bluetooth > HDMI > altavoces internos.
# El micrófono sigue al dispositivo: jack > USB > Bluetooth > interno.

set -u

mode="${1:-auto}"
VOL=50
MUTE=false
SAVED_VOLUME=0

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

have_pactl() {
  command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1
}

save_volume() {
  SAVED_VOLUME=1
  if command -v pamixer >/dev/null 2>&1; then
    VOL=$(pamixer --get-volume 2>/dev/null || echo 50)
    MUTE=$(pamixer --get-mute 2>/dev/null || echo false)
  fi
}

restore_volume() {
  [ "$SAVED_VOLUME" = "1" ] || return 0
  command -v pamixer >/dev/null 2>&1 || return 0
  pamixer --allow-boost --set-volume "$VOL" >/dev/null 2>&1 || true
  if [ "$MUTE" = "true" ]; then
    pamixer --mute >/dev/null 2>&1 || true
  else
    pamixer --unmute >/dev/null 2>&1 || true
  fi
}

first_sink() {
  pactl list short sinks 2>/dev/null | awk -v pat="$1" '$2 ~ pat {print $2; exit}'
}

first_source() {
  pactl list short sources 2>/dev/null | awk -v pat="$1" '$2 ~ pat {print $2; exit}'
}

wait_for_sink() {
  pat="$1"
  tries="${2:-30}"
  i=0
  while [ "$i" -lt "$tries" ]; do
    sink=$(first_sink "$pat")
    if [ -n "$sink" ]; then
      printf '%s\n' "$sink"
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

find_analog_source() {
  pactl list short sources 2>/dev/null |
    awk '$2 ~ /analog/ && $2 !~ /monitor/ {print $2; exit}'
}

wait_for_analog_source() {
  tries="${1:-20}"
  i=0
  while [ "$i" -lt "$tries" ]; do
    src=$(find_analog_source)
    if [ -n "$src" ]; then
      printf '%s\n' "$src"
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

find_usb_source() {
  first_source '^alsa_input\.usb-'
}

bt_mac_from_sink() {
  printf '%s' "$1" | sed -e 's/^bluez_output\.//' -e 's/\.[0-9][0-9]*$//'
}

# Busca el source loopback de BlueZ (bluez_input.<mac>). Ese nodo es
# estable entre A2DP y HFP y es el que dispara el autoswitch de perfil
# de WirePlumber cuando una aplicación graba.
find_bt_source() {
  [ -n "${1:-}" ] || return 1
  pactl list short sources 2>/dev/null | awk -v mac="$1" '
    {
      name = $2
      norm = name
      m = mac
      gsub(/[^0-9A-Za-z]/, "", norm)
      gsub(/[^0-9A-Za-z]/, "", m)
      if (name ~ /^bluez_input\./ && index(norm, m) > 0) {
        print name
        exit
      }
    }'
}

wait_for_bt_source() {
  mac="$1"
  tries="${2:-30}"
  i=0
  while [ "$i" -lt "$tries" ]; do
    src=$(find_bt_source "$mac" 2>/dev/null || true)
    if [ -n "$src" ]; then
      printf '%s\n' "$src"
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  return 1
}

hdmi_card() {
  pactl list cards 2>/dev/null | awk '
    /^[[:space:]]*Name: / { name=$2 }
    /output:hdmi-stereo:.*available: yes/ { print name; exit }
    /output:hdmi-stereo\+input:analog-stereo:.*available: yes/ { print name; exit }
  '
}

analog_card() {
  pactl list cards 2>/dev/null | awk '
    /^[[:space:]]*Name: / { name=$2 }
    /output:analog-stereo\+input:analog-stereo:.*available: yes/ { print name; exit }
    /output:analog-stereo:.*available: yes/ { if (name != "") { print name; exit } }
  '
}

headphones_available() {
  pactl list cards 2>/dev/null | grep -qE 'analog-output-headphones:.*, available\)'
}

hdmi_available() {
  pactl list cards 2>/dev/null | grep -qE 'hdmi-output-[0-9]+:.*, available\)'
}

move_streams() {
  sink="$1"
  pactl list short sink-inputs 2>/dev/null | awk '{print $1}' | while read -r id; do
    [ -n "$id" ] && pactl move-sink-input "$id" "$sink" >/dev/null 2>&1 || true
  done
}

move_source_streams() {
  source="$1"
  pactl list short source-outputs 2>/dev/null | awk '{print $1}' | while read -r id; do
    [ -n "$id" ] && pactl move-source-output "$id" "$source" >/dev/null 2>&1 || true
  done
}

set_source_port() {
  source="$1"
  shift
  [ -n "$source" ] || return 0

  for port in "$@"; do
    if pactl set-source-port "$source" "$port" >/dev/null 2>&1; then
      pactl set-default-source "$source" >/dev/null 2>&1 || true
      move_source_streams "$source"
      return 0
    fi
  done
  pactl set-default-source "$source" >/dev/null 2>&1 || true
  move_source_streams "$source"
}

switch_bluetooth() {
  sink=$(wait_for_sink '^bluez_output\.' 30) || return 1
  pactl set-default-sink "$sink" >/dev/null 2>&1 || return 1
  move_streams "$sink"

  mac=$(bt_mac_from_sink "$sink")
  src=$(wait_for_bt_source "$mac" 30) || true
  if [ -n "$src" ]; then
    pactl set-default-source "$src" >/dev/null 2>&1 || true
    move_source_streams "$src"
    log "audio: bluetooth ($sink, micrófono $src)"
  else
    log "audio: bluetooth ($sink, sin source de micrófono)"
  fi
  return 0
}

switch_usb() {
  sink=$(wait_for_sink '^alsa_output\.usb-' 30) || return 1
  pactl set-default-sink "$sink" >/dev/null 2>&1 || return 1
  move_streams "$sink"

  src=$(find_usb_source)
  if [ -n "$src" ]; then
    pactl set-default-source "$src" >/dev/null 2>&1 || true
    move_source_streams "$src"
    log "audio: USB ($sink, micrófono $src)"
  else
    src=$(wait_for_analog_source 20) || true
    if [ -n "$src" ]; then
      set_source_port "$src" analog-input-mic
    fi
    log "audio: USB ($sink, micrófono interno)"
  fi
  return 0
}

switch_hdmi() {
  card=$(hdmi_card)
  [ -n "$card" ] || return 1

  # Mantener la entrada analógica en el perfil conserva el micrófono
  # interno aunque la salida sea HDMI.
  if ! pactl set-card-profile "$card" output:hdmi-stereo+input:analog-stereo >/dev/null 2>&1; then
    pactl set-card-profile "$card" output:hdmi-stereo >/dev/null 2>&1 || return 1
  fi

  sink=$(wait_for_sink 'hdmi' 30) || return 1
  pactl set-default-sink "$sink" >/dev/null 2>&1 || return 1
  move_streams "$sink"

  src=$(wait_for_analog_source 20) || true
  if [ -n "$src" ]; then
    set_source_port "$src" analog-input-mic
  fi

  log "audio: HDMI ($sink)"
  return 0
}

switch_analog() {
  target="$1" # headphones|analog
  card=$(analog_card)
  [ -n "$card" ] || return 1

  # Solo conservamos el volumen si ya estábamos en el sink analógico;
  # no arrastramos el volumen de HDMI/Bluetooth a otro dispositivo.
  saved=0
  current=$(pactl get-default-sink 2>/dev/null || true)
  case "$current" in
    *analog*) save_volume; saved=1 ;;
  esac

  if ! pactl set-card-profile "$card" output:analog-stereo+input:analog-stereo >/dev/null 2>&1; then
    pactl set-card-profile "$card" output:analog-stereo >/dev/null 2>&1 || return 1
  fi

  sink=$(wait_for_sink 'analog' 30) || return 1
  if [ "$target" = "headphones" ]; then
    pactl set-sink-port "$sink" analog-output-headphones >/dev/null 2>&1 || true
  else
    pactl set-sink-port "$sink" analog-output-speaker >/dev/null 2>&1 || true
  fi

  pactl set-default-sink "$sink" >/dev/null 2>&1 || return 1
  move_streams "$sink"
  if [ "$saved" = "1" ]; then
    restore_volume
  fi

  source=$(wait_for_analog_source 20) || true
  if [ -n "$source" ]; then
    if [ "$target" = "headphones" ]; then
      set_source_port "$source" analog-input-headset-mic analog-input-mic
    else
      set_source_port "$source" analog-input-mic
    fi
  fi

  log "audio: $target ($sink)"
  return 0
}

have_pactl || exit 0

if [ "$mode" = "auto" ]; then
  if headphones_available; then
    mode=headphones
  elif [ -n "$(first_sink '^alsa_output\.usb-')" ]; then
    mode=usb
  elif [ -n "$(first_sink '^bluez_output\.')" ]; then
    mode=bluetooth
  elif hdmi_available; then
    mode=hdmi
  else
    mode=analog
  fi
fi

case "$mode" in
  headphones) switch_analog headphones ;;
  analog) switch_analog analog ;;
  usb) switch_usb ;;
  bluetooth) switch_bluetooth ;;
  hdmi) switch_hdmi ;;
  *) log "modo desconocido: $mode"; exit 1 ;;
esac
