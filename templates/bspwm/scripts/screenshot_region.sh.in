#!/bin/sh
# screenshot_region — selecciona una región con scrot y la copia al portapapeles.
# No deja archivo: usa un directorio temporal que se borra al salir.

set -u

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/scrot.XXXXXX") || exit 1
trap 'rm -rf "$tmpdir"' 0 1 2 15
tmp="$tmpdir/capture.png"

if ! scrot -s --line 'mode=edge,color=#FF00FF,width=2,opacity=255' -q 100 "$tmp"; then
  # Selección cancelada o scrot falló.
  exit 0
fi

# scrot deja a veces el rectángulo de selección pintado en la pantalla.
command -v xrefresh >/dev/null 2>&1 && xrefresh >/dev/null 2>&1 || true

if xclip -selection clipboard -t image/png -i "$tmp"; then
  notify-send "Captura" "Región copiada al portapapeles"
else
  notify-send -u critical "Captura" "No se pudo copiar al portapapeles"
fi
