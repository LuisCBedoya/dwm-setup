#!/bin/sh
# screenshot — menú rofi para capturas de pantalla
# Requiere: scrot, rofi, xclip

SHOT_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$SHOT_DIR" 2>/dev/null || true

choice=$(printf '%s\n' \
  "  Pantalla completa" \
  "  Área seleccionada" \
  "  Ventana activa" \
  "  Pantalla completa (clipboard)" \
  "  Área seleccionada (clipboard)" \
  "  Ventana activa (clipboard)" \
  | rofi -dmenu -i -p "Captura" \
      -theme @HOME@/.config/rofi/powermenu.rasi -width 320)

case "$choice" in
  *"Pantalla completa (clipboard)"*)
    scrot -q 100 - | xclip -selection clipboard -t image/png
    notify-send "Captura" "Pantalla completa en clipboard"
    ;;
  *"Área seleccionada (clipboard)"*)
    scrot -s --line 'mode=edge,color=#FF00FF,width=2,opacity=255' -q 100 - | xclip -selection clipboard -t image/png
    command -v xrefresh >/dev/null 2>&1 && xrefresh >/dev/null 2>&1 || true
    notify-send "Captura" "Área en clipboard"
    ;;
  *"Ventana activa (clipboard)"*)
    scrot -u -q 100 - | xclip -selection clipboard -t image/png
    notify-send "Captura" "Ventana en clipboard"
    ;;
  *"Pantalla completa"*)
    scrot -q 100 "$SHOT_DIR/%Y-%m-%d_%H-%M-%S.png" 2>/dev/null \
      || scrot -q 100 "/tmp/screenshot_%Y-%m-%d_%H-%M-%S.png"
    notify-send "Captura" "Pantalla completa guardada"
    ;;
  *"Área seleccionada"*)
    scrot -s --line 'mode=edge,color=#FF00FF,width=2,opacity=255' -q 100 "$SHOT_DIR/%Y-%m-%d_%H-%M-%S.png" 2>/dev/null \
      || scrot -s --line 'mode=edge,color=#FF00FF,width=2,opacity=255' -q 100 "/tmp/screenshot_%Y-%m-%d_%H-%M-%S.png"
    command -v xrefresh >/dev/null 2>&1 && xrefresh >/dev/null 2>&1 || true
    notify-send "Captura" "Área seleccionada guardada"
    ;;
  *"Ventana activa"*)
    scrot -u -q 100 "$SHOT_DIR/%Y-%m-%d_%H-%M-%S.png" 2>/dev/null \
      || scrot -u -q 100 "/tmp/screenshot_%Y-%m-%d_%H-%M-%S.png"
    notify-send "Captura" "Ventana activa guardada"
    ;;
esac
