#!/bin/sh
# autostart — generado desde template, no editar directamente
# Se ejecuta al iniciar bspwm (desde bspwmrc)

set -u

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dwm-setup"
mkdir -p "$LOG_DIR" 2>/dev/null || true
LOG_FILE="$LOG_DIR/session.log"
exec >>"$LOG_FILE" 2>&1
printf '\n[%s] autostart\n' "$(date '+%Y-%m-%d %H:%M:%S')"

# --- Portal de escritorio: DISPLAY en el bus de systemd --user ---
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment DISPLAY XAUTHORITY 2>/dev/null || true
  systemctl --user restart xdg-desktop-portal 2>/dev/null || true
fi

# Esperar a que X esté listo
sleep 0.5

# --- Pantalla siempre encendida ---
# Sin salvapantallas ni DPMS: no se apaga ni bloquea por inactividad.
# xss-lock sigue bloqueando al suspender y con Super+Shift+L.
xset s off 2>/dev/null || true
xset s noblank 2>/dev/null || true
xset -dpms 2>/dev/null || true

# --- Pantallas: adaptar salidas conectadas y no-blanqueo (todo terreno) ---
if [ -x "$HOME/.config/bspwm/scripts/display-setup.sh" ]; then
  "$HOME/.config/bspwm/scripts/display-setup.sh" apply 2>/dev/null || true
fi

# --- Directorios de usuario ---
mkdir -p "$HOME/Pictures/Screenshots" 2>/dev/null || true

# --- picom (compositor: se arranca con la sesión) ---
# Guard con pgrep: si el usuario ya lo arrancó, no lo duplicamos.
if command -v picom >/dev/null 2>&1 && ! pgrep -x picom >/dev/null 2>&1; then
  picom -b --config "$HOME/.config/picom/picom.conf"
fi

# --- Polybar ---
@HOME@/.config/polybar/launch.sh &

# --- Notificaciones ---
if [ -x "$HOME/.config/bspwm/scripts/dunst-position.sh" ]; then
  "$HOME/.config/bspwm/scripts/dunst-position.sh" 2>/dev/null || true
fi
dunst &

# --- Wallpaper (principal o alternativo) ---
if [ -x "$HOME/.config/bspwm/scripts/wallpaper.sh" ]; then
  "$HOME/.config/bspwm/scripts/wallpaper.sh" apply 2>/dev/null || true
elif command -v xwallpaper >/dev/null 2>&1; then
  xwallpaper --zoom @WALLPAPER@ &
elif command -v feh >/dev/null 2>&1; then
  feh --bg-scale @WALLPAPER@ &
fi

# --- Montaje automático USB + notificaciones ---
# Sin -t: la barra no tiene bandeja de sistema.
udiskie -N -a &

# --- Audio: auriculares > HDMI > altavoces ---
@HOME@/.config/bspwm/scripts/audio-watch.sh &

# --- Bloqueo de pantalla (xss-lock + i3lock) ---
xss-lock -- /usr/local/bin/desktop-safe lock &

# --- Notificador de batería baja (solo si hay batería) ---
if [ -d "/sys/class/power_supply/@BATTERY@" ]; then
  @HOME@/.config/bspwm/scripts/low_bat_notifier.sh &
fi

# --- Teclado ---
setxkbmap @KEYMAP@ 2>/dev/null || true

# --- Tema GTK e iconos (según el modo activo en ~/.config/dwm-setup/gtk.env) ---
if command -v gsettings >/dev/null 2>&1; then
  gtk_theme="catppuccin-mocha-black"
  icon_theme="Catppuccin-Mocha"
  gtk_env_file="$HOME/.config/dwm-setup/gtk.env"
  if [ -f "$gtk_env_file" ]; then
    gtk_theme=$(sed -n 's/^GTK_THEME=//p' "$gtk_env_file" | head -1)
    icon_theme=$(sed -n 's/^ICON_THEME=//p' "$gtk_env_file" | head -1)
  fi
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || true
fi

# --- Thunar: menú, panel lateral y barra de estado ocultos ---
if [ -x "$HOME/.config/bspwm/scripts/thunar-defaults.sh" ]; then
  "$HOME/.config/bspwm/scripts/thunar-defaults.sh" 2>/dev/null || true
fi

# --- Cursor ---
xsetroot -cursor_name left_ptr &

# --- Polkit agent (lxpolkit es el que está instalado) ---
if command -v lxpolkit >/dev/null 2>&1; then
  lxpolkit &
fi
