#! /bin/sh
# bspwmrc — generado desde template, no editar directamente
# Paleta: @THEME_NAME@

pgrep -x sxhkd > /dev/null || sxhkd -c @HOME@/.config/sxhkd/sxhkdrc &

# Monitores y escritorios
# Escritorios dinámicos (ADR-112): arranca con uno solo; workspace.sh
# crea los demás bajo demanda y el daemon borra los que quedan vacíos.
bspc monitor -d 1

# Daemon de escritorios dinámicos: borra los vacíos al cambiar de foco
if ! pgrep -f '@HOME@/.config/bspwm/scripts/workspace.sh daemon' >/dev/null 2>&1; then
  @HOME@/.config/bspwm/scripts/workspace.sh daemon &
fi

# Geometría
bspc config border_width         3
bspc config window_gap          10
position="top"
if [ -r "@HOME@/.config/polybar/position" ]; then
  position=$(cat "@HOME@/.config/polybar/position" 2>/dev/null || printf 'top')
fi
case "$position" in
  bottom)
    bspc config top_padding         0
    bspc config bottom_padding      @BAR_HEIGHT@
    ;;
  *)
    bspc config top_padding         @BAR_HEIGHT@
    bspc config bottom_padding      0
    ;;
esac

bspc config split_ratio          0.50
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Colores (desde la paleta activa)
bspc config normal_border_color  "@COLOR_BORDER@"
bspc config focused_border_color "@COLOR_ACCENT_ALT@"
bspc config active_border_color  "@COLOR_BG_ELEV@"
bspc config presel_feedback_color "@COLOR_ACCENT_ALT@"

# Reglas de ventanas (ejemplos, ajustar según necesidad)
# bspc rule -a Gimp desktop='^8' state=floating follow=on
# bspc rule -a Chromium desktop='^2'
# bspc rule -a mplayer2 state=floating
# bspc rule -a Kupfer.py focus=on
# bspc rule -a Screenkey manage=off

# Autostart
@HOME@/.config/bspwm/scripts/autostart &