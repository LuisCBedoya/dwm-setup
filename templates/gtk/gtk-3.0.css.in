/* Mono Slate — override para apps GTK3 (Thunar incluido)
 * Se carga después del tema Windows-10-Dark. */

@define-color theme_bg_color                  @COLOR_BG_ALT@;
@define-color theme_base_color                @COLOR_BG@;
@define-color theme_fg_color                  @COLOR_FG@;
@define-color theme_text_color                @COLOR_FG@;
@define-color theme_selected_bg_color         @COLOR_ACCENT@;
@define-color theme_selected_fg_color         @COLOR_BG@;
@define-color theme_unfocused_bg_color        @COLOR_BG_ALT@;
@define-color theme_unfocused_base_color      @COLOR_BG@;
@define-color theme_unfocused_fg_color        @COLOR_FG@;
@define-color theme_unfocused_text_color      @COLOR_FG@;
@define-color theme_unfocused_selected_bg_color @COLOR_BG_HOVER@;
@define-color theme_unfocused_selected_fg_color @COLOR_FG@;
@define-color insensitive_bg_color            @COLOR_BG_ALT@;
@define-color insensitive_fg_color            @COLOR_FG_DIM@;
@define-color borders                         @COLOR_BORDER@;
@define-color unfocused_borders               @COLOR_BORDER@;
@define-color content_view_bg                 @COLOR_BG@;
@define-color text_view_bg                    @COLOR_BG@;
@define-color menu_bg_color                   @COLOR_BG_ALT@;
@define-color menu_fg_color                   @COLOR_FG@;
@define-color popover_bg_color                @COLOR_BG_ALT@;
@define-color popover_fg_color                @COLOR_FG@;
@define-color tooltip_bg_color                @COLOR_BG_ELEV@;
@define-color tooltip_fg_color                @COLOR_FG@;

window,
.background {
	background-color: @COLOR_BG_ALT@;
	color: @COLOR_FG@;
}

viewport,
.viewport,
scrolledwindow,
scrolledwindow > viewport {
	background-color: @COLOR_BG@;
	border: none;
	box-shadow: none;
}

.view,
iconview.view,
treeview.view {
	background-color: @COLOR_BG@;
	color: @COLOR_FG@;
}

.view:selected,
iconview.view:selected,
treeview.view:selected,
treeview.view:selected:focus {
	background-color: @COLOR_ACCENT@;
	color: @COLOR_BG@;
}

menubar,
.menubar {
	background-color: @COLOR_BG@;
	color: @COLOR_FG@;
	border: none;
	box-shadow: none;
}

menubar > menuitem:hover,
.menubar .menuitem:hover {
	background-color: @COLOR_BG_HOVER@;
	color: @COLOR_FG@;
}

menu,
.menu,
.context-menu {
	background-color: @COLOR_BG_ALT@;
	color: @COLOR_FG@;
	border: 1px solid @COLOR_BORDER@;
}

menu menuitem:hover {
	background-color: @COLOR_BG_HOVER@;
	color: @COLOR_FG@;
}

toolbar,
.toolbar,
.primary-toolbar {
	background-color: @COLOR_BG@;
	border: none;
	box-shadow: none;
	padding: 0;
}

toolbar button,
.toolbar button {
	background-image: none;
	background-color: transparent;
	border: none;
	box-shadow: none;
	padding: 1px 3px;
	min-height: 18px;
	min-width: 18px;
}

toolbar button:hover,
.toolbar button:hover {
	background-color: @COLOR_BG_HOVER@;
}

headerbar,
.titlebar {
	background-color: @COLOR_BG_ALT@;
	color: @COLOR_FG@;
	border-bottom: 1px solid @COLOR_BORDER@;
	box-shadow: none;
}

headerbar button,
.titlebar button {
	background-image: none;
	box-shadow: none;
	border: 1px solid @COLOR_BORDER@;
}

.sidebar {
	background-color: @COLOR_BG_ALT@;
	border-right: 1px solid @COLOR_BORDER@;
}

.sidebar treeview.view {
	padding: 1px 2px;
}

statusbar {
	background-color: @COLOR_BG@;
	color: @COLOR_FG_MUTED@;
	border-top: 1px solid @COLOR_BORDER@;
}

separator {
	background-color: @COLOR_BORDER@;
	min-width: 1px;
	min-height: 1px;
}

entry {
	background-color: @COLOR_BG@;
	color: @COLOR_FG@;
	border: 1px solid @COLOR_BORDER@;
	box-shadow: none;
}

entry:focus {
	border-color: @COLOR_ACCENT@;
}

button {
	background-image: none;
	background-color: @COLOR_BG_ALT@;
	color: @COLOR_FG@;
	border: 1px solid @COLOR_BORDER@;
	box-shadow: none;
}

button:hover {
	background-color: @COLOR_BG_HOVER@;
}

button:active,
button:checked {
	background-color: @COLOR_ACCENT@;
	color: @COLOR_BG@;
}

scrollbar slider {
	background-color: @COLOR_BG_HOVER@;
	border: none;
	min-width: 6px;
	min-height: 6px;
}

scrollbar slider:hover {
	background-color: @COLOR_FG_DIM@;
}

tooltip {
	background-color: @COLOR_BG_ELEV@;
	color: @COLOR_FG@;
	border: 1px solid @COLOR_BORDER@;
}
