/* Catppuccin — ajustes estructurales para apps GTK3.
 * Sin colores: el tema del modo (catppuccin-*) los pone y xsettingsd
 * puede cambiarlo en caliente sin recargar este archivo. */

viewport,
.viewport,
scrolledwindow,
scrolledwindow > viewport {
	border: none;
	box-shadow: none;
}

menubar,
.menubar {
	border: none;
	box-shadow: none;
}

toolbar,
.toolbar,
.primary-toolbar {
	border: none;
	box-shadow: none;
	padding: 0;
}

toolbar button,
.toolbar button {
	background-image: none;
	border: none;
	box-shadow: none;
	padding: 1px 3px;
	min-height: 18px;
	min-width: 18px;
}

headerbar,
.titlebar {
	box-shadow: none;
}

headerbar button,
.titlebar button {
	background-image: none;
	box-shadow: none;
}

.sidebar treeview.view {
	padding: 1px 2px;
}

entry {
	box-shadow: none;
}

button {
	background-image: none;
	box-shadow: none;
}

scrollbar slider {
	border: none;
	min-width: 6px;
	min-height: 6px;
}

separator {
	min-width: 1px;
	min-height: 1px;
}
