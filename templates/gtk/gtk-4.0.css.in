/* Catppuccin — ajustes estructurales para apps GTK4.
 * Sin colores: el tema del modo (catppuccin-*) los pone y xsettingsd
 * puede cambiarlo en caliente sin recargar este archivo. */

viewport,
.viewport,
scrolledwindow,
scrolledwindow > viewport {
	border: none;
	box-shadow: none;
}

headerbar,
.titlebar {
	box-shadow: none;
}

entry {
	box-shadow: none;
}

button {
	background-image: none;
	box-shadow: none;
}

scrollbar slider {
	border: none;
	min-width: 6px;
	min-height: 6px;
}

separator {
	min-width: 1px;
	min-height: 1px;
}
