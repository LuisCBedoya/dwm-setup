# VLC — interfaz según el modo activo
# qt-dark-palette=1 en oscuro, 0 en claro.
qt-dark-palette=@THEME_VLC_DARK@
# Decodificación por hardware (VA-API) con fallback automático.
avcodec-hw=any
# Salida GL: necesaria para que VA-API convierta las superficies sin errores.
vout=gl
# Sin diálogo de privacidad en el primer arranque ni metadatos en red.
qt-privacy-ask=0
metadata-network-access=0
