// Firefox — preferencias de modo. Generado desde la paleta activa.
// No editar a mano: usa `theme-mode dark|light`.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("ui.systemUsesDarkTheme", @THEME_PREFERS_DARK@);
user_pref("layout.css.prefers-color-scheme.content-override", @THEME_CONTENT_OVERRIDE@);
// Mantiene las barras visibles al entrar en pantalla completa (ajuste del usuario).
user_pref("browser.fullscreen.autohide", false);
// Decodificación de vídeo por GPU (VA-API). Firefox la usa solo si el
// driver existe (Intel iHD/AMD); si no, cae a CPU sin romper nada.
user_pref("media.ffmpeg.vaapi.enabled", true);
// Barra lateral: dejar solo Historial y Marcadores como herramientas.
user_pref("sidebar.main.tools", "history,bookmarks");
// ── Telemetría desactivada (prefs + policies DisableTelemetry) ──
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("toolkit.telemetry.archive.enabled", false);
user_pref("toolkit.telemetry.server", "data:,");
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("browser.ping-centre.telemetry", false);
user_pref("app.normandy.enabled", false);
user_pref("app.shield.optoutstudies.enabled", false);
user_pref("browser.discovery.enabled", false);
user_pref("browser.newtabpage.activity-stream.telemetry", false);
user_pref("browser.newtabpage.activity-stream.feeds.telemetry", false);
user_pref("browser.crashReports.unsubmittedCheck.autoSubmit2", false);
user_pref("security.ssl.errorReporting.enabled", false);
user_pref("extensions.pocket.enabled", false);
