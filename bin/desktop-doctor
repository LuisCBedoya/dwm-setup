#!/bin/sh
# desktop-doctor — Diagnóstico del escritorio bspwm+polybar
# Instalado en /usr/local/bin/desktop-doctor

set -u

HOME="${HOME:-/home/${USER:-$(id -un)}}"
CONFIG="$HOME/.config"

print_header() {
  printf '\n=== %s ===\n' "$1"
}

check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    printf '  [OK] %s\n' "$1"
  else
    printf '  [FALTA] %s\n' "$1"
  fi
}

check_file() {
  if [ -f "$1" ]; then
    printf '  [OK] %s\n' "$1"
  else
    printf '  [FALTA] %s\n' "$1"
  fi
}

check_dir() {
  if [ -d "$1" ]; then
    printf '  [OK] %s\n' "$1"
  else
    printf '  [FALTA] %s\n' "$1"
  fi
}

check_exec() {
  if [ -x "$1" ]; then
    printf '  [OK] %s (ejecutable)\n' "$1"
  else
    printf '  [MAL] %s (sin permiso de ejecución)\n' "$1"
  fi
}

# ─── Binarios ───
print_header "Binarios esenciales"
for c in bspwm sxhkd polybar dunst rofi kitty feh flameshot i3lock xss-lock \
         brightnessctl xclip thunar udiskie v4l2-ctl ffmpeg pamixer wpctl \
         xwallpaper playerctl lxpolkit; do
  check_cmd "$c"
done

# ─── Configs ───
print_header "Archivos de configuración"
check_file "$CONFIG/bspwm/bspwmrc"
check_exec "$CONFIG/bspwm/bspwmrc"
check_file "$CONFIG/bspwm/scripts/autostart"
check_file "$CONFIG/sxhkd/sxhkdrc"
check_file "$CONFIG/polybar/config.ini"
check_file "$CONFIG/polybar/launch.sh"
check_file "$CONFIG/dunst/dunstrc"
check_file "$CONFIG/rofi/powermenu.rasi"
check_file "$CONFIG/kitty/kitty.conf"
check_file "$HOME/.xinitrc"
check_file "$HOME/.local/share/wallpapers/rocky.jpg"
check_dir "$HOME/Pictures/Screenshots"

# ─── Servicios ───
print_header "Servicios systemd"
for s in udisks2 NetworkManager; do
  status=$(systemctl is-enabled "$s" 2>/dev/null || true)
  case "$status" in
    enabled|static) printf '  [OK] %s (enabled)\n' "$s" ;;
    *) printf '  [WARN] %s (%s)\n' "$s" "${status:-desconocido}" ;;
  esac
done

# ─── Hardware ───
print_header "Hardware detectado"
printf '  GPU: '
if command -v lspci >/dev/null 2>&1; then
  gpu=$(lspci 2>/dev/null | grep -E 'VGA|3D' | head -1 | sed 's/.*: //')
  printf '%s\n' "${gpu:-desconocida}"
else
  printf 'desconocida\n'
fi

printf '  Audio: '
if command -v pactl >/dev/null 2>&1; then
  audio=$(pactl info 2>/dev/null | awk -F': ' '/Server Name/ {print $2; exit}')
  printf '%s\n' "${audio:-no detectado}"
else
  printf 'no detectado\n'
fi

printf '  Cámaras: '
found_cam=0
for dev in /dev/video*; do
  [ -e "$dev" ] || continue
  printf '%s ' "$dev"
  found_cam=1
done
if [ "$found_cam" -eq 1 ]; then printf '\n'; else printf 'ninguna\n'; fi

printf '  Batería: '
found_bat=0
for bat in /sys/class/power_supply/BAT*; do
  [ -d "$bat" ] || continue
  printf '%s ' "$(basename "$bat")"
  found_bat=1
done
if [ "$found_bat" -eq 1 ]; then printf '\n'; else printf 'ninguna\n'; fi

# ─── Procesos (si estamos en sesión gráfica) ───
if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
  print_header "Procesos en sesión actual"
  for p in bspwm sxhkd polybar dunst lxpolkit udiskie xss-lock; do
    if pgrep -x "$p" >/dev/null 2>&1; then
      printf '  [RUNNING] %s\n' "$p"
    else
      printf '  [STOPPED] %s\n' "$p"
    fi
  done
fi

# ─── Cámara (--camera) ───
if [ "${1:-}" = "--camera" ]; then
  print_header "Prueba de cámara"
  if ! command -v v4l2-ctl >/dev/null 2>&1; then
    printf '  v4l2-ctl no instalado\n'
    exit 1
  fi
  tested=0
  for dev in /dev/video*; do
    [ -e "$dev" ] || continue
    tested=1
    printf '  Dispositivo: %s\n' "$dev"
    v4l2-ctl --device="$dev" --list-formats-ext 2>/dev/null | head -20
    if command -v ffmpeg >/dev/null 2>&1; then
      out="/tmp/test-cam-$(date +%s).jpg"
      if ffmpeg -f v4l2 -i "$dev" -vframes 1 -y "$out" -loglevel error 2>/dev/null; then
        printf '  Captura OK: %s (%s bytes)\n' "$out" "$(stat -c%s "$out" 2>/dev/null || printf '?')"
        rm -f "$out"
      else
        printf '  Captura FALLÓ\n'
      fi
    fi
  done
  if [ "$tested" -eq 0 ]; then
    printf '  No hay dispositivos /dev/video*\n'
  fi
fi

printf '\n'
