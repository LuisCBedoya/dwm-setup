#!/usr/bin/env bash
# yt-update-notify — avisa por dunst (un solo toast) si el software de
# YouTube está desactualizado: yt-dlp, ytwatch o ueberzugpp.
#
# Lo ejecuta dwm-setup-yt-update-notify.timer (unidad de usuario, diaria).
# Solo lee: no actualiza nada y no usa sudo. Silencio total si todo está al día.
set -Eeuo pipefail

find_bin() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
  elif [[ -x "/usr/local/bin/$name" ]]; then
    printf '%s\n' "/usr/local/bin/$name"
  fi
}

lines=()

ytdlp=$(find_bin ytdlp-check || true)
if [[ -n "$ytdlp" ]]; then
  out=$("$ytdlp" --quiet --no-notify 2>/dev/null || true)
  [[ -n "$out" ]] && lines+=("$out")
fi

ytwatch=$(find_bin ytwatch-check || true)
if [[ -n "$ytwatch" ]]; then
  out=$("$ytwatch" --quiet --no-notify 2>/dev/null || true)
  [[ -n "$out" ]] && lines+=("$out")
fi

# Nada pendiente: silencio absoluto (el timer no molesta).
((${#lines[@]} > 0)) || exit 0

body=$(printf '%s\n' "${lines[@]}")
body+=$'\n\nActualiza con: ytdlp-update · ytwatch-update'

# Abre una terminal visible con la secuencia de actualización.
run_update_terminal() {
  local cmd='ytdlp-update; ytwatch-update; ytwatch-update --ueberzugpp; printf "\nListo. Pulsa Enter para cerrar.\n"; read -r _'
  if command -v kitty >/dev/null 2>&1; then
    setsid kitty --title "dwm-setup: actualizar" -e sh -c "$cmd" >/dev/null 2>&1 &
  else
    setsid sh -c "$cmd" >/dev/null 2>&1 &
  fi
}

printf '%s\n' "$body"
if command -v notify-send >/dev/null 2>&1; then
  if notify-send --help 2>&1 | grep -q -- '--action'; then
    # Toast persistente con acción: al pulsarlo se abre la terminal de updates.
    (
      action=$(notify-send -a "dwm-setup" -i software-update-available \
        -A "default=Actualizar ahora" \
        "Software de YouTube desactualizado" "$body" 2>/dev/null) || true
      [[ "$action" == "default" ]] && run_update_terminal
    ) &
  else
    notify-send -a "dwm-setup" -i software-update-available \
      "Software de YouTube desactualizado" "$body" 2>/dev/null || true
  fi
fi
