#!/bin/sh
# luc-workspace-power-profile — perfil de energía completo (gobernador + EPP + suelo).
#
#   ac       -> performance + EPP performance + suelo mínimo del CPU
#   battery  -> powersave + EPP balance_performance + suelo 1.2 GHz
#
# Lo usan los daemons de energía y el clic del módulo "governor" de polybar.
set -u

profile=${1:-}
case "$profile" in
  ac|battery) ;;
  *)
    echo "uso: $0 ac|battery" >&2
    exit 2
    ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "requiere root" >&2; exit 1; }

CPUDIR=${LUC_WORKSPACE_CPUFREQ:-/sys/devices/system/cpu/cpufreq}
BAT_MIN_FREQ=${LUC_WORKSPACE_BATTERY_MIN_FREQ:-1200000}

if [ "$profile" = ac ]; then
  want_gov=performance
  want_epp=performance
  want_floor=min
else
  want_gov=powersave
  want_epp=balance_performance
  want_floor=$BAT_MIN_FREQ
fi

applied=0
for pol in "$CPUDIR"/policy*; do
  [ -d "$pol" ] || continue

  # Gobernador (solo si está disponible)
  if [ -w "$pol/scaling_governor" ] &&
     grep -qw "$want_gov" "$pol/scaling_available_governors" 2>/dev/null; then
    if printf '%s\n' "$want_gov" >"$pol/scaling_governor" 2>/dev/null; then
      applied=$((applied + 1))
    fi
  fi

  # EPP (solo si el CPU lo expone y acepta el valor)
  if [ -w "$pol/energy_performance_preference" ] &&
     grep -qx "$want_epp" "$pol/energy_performance_available_preferences" 2>/dev/null; then
    printf '%s\n' "$want_epp" >"$pol/energy_performance_preference" 2>/dev/null || true
  fi

  # Suelo de frecuencia
  if [ -w "$pol/scaling_min_freq" ]; then
    floor=$want_floor
    if [ "$floor" = min ]; then
      floor=$(cat "$pol/cpuinfo_min_freq" 2>/dev/null || printf '')
    fi
    max=$(cat "$pol/cpuinfo_max_freq" 2>/dev/null || printf '')
    case "$floor" in ''|*[!0-9]*) floor='' ;; esac
    case "$max" in ''|*[!0-9]*) max='' ;; esac
    if [ -n "$floor" ] && [ -n "$max" ] && [ "$floor" -gt "$max" ]; then
      floor=$max
    fi
    [ -n "$floor" ] && printf '%s\n' "$floor" >"$pol/scaling_min_freq" 2>/dev/null || true
  fi
done

if [ "$applied" -eq 0 ]; then
  echo "no se pudo aplicar el perfil $profile" >&2
  exit 1
fi

gov=$(cat "$CPUDIR/policy0/scaling_governor" 2>/dev/null || printf '?')
epp=$(cat "$CPUDIR/policy0/energy_performance_preference" 2>/dev/null || printf '-')
min=$(cat "$CPUDIR/policy0/scaling_min_freq" 2>/dev/null || printf '?')
printf 'perfil %s: governor=%s epp=%s min=%s\n' "$profile" "$gov" "$epp" "$min"
exit 0
