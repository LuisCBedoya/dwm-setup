#!/bin/sh
# dwm-setup-fan-auto — modo del ventilador automático por temperatura/carga.
#
# Solo actúa si el estado es "auto" (~/.config/dwm-setup/fan-mode).
#   sube a overboost si temp >= FAN_TEMP_HIGH o cpu >= FAN_LOAD_HIGH
#   baja a normal     si temp <= FAN_TEMP_LOW  y cpu <  FAN_LOAD_LOW
# con histéresis y ventanas de confirmación por muestras.
set -u

HELPER=${DWM_SETUP_FAN_HELPER:-/usr/local/bin/dwm-setup-fan-mode}
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/dwm-setup
STATE=$CONF_DIR/fan-mode
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/dwm-setup
EFFECTIVE=$CACHE_DIR/fan-effective

POLL=${FAN_POLL:-5}
T_HIGH=${FAN_TEMP_HIGH:-80}
T_LOW=${FAN_TEMP_LOW:-70}
L_HIGH=${FAN_LOAD_HIGH:-80}
L_LOW=${FAN_LOAD_LOW:-40}
UP_SAMPLES=${FAN_UP_SAMPLES:-2}     # 2 x 5 s = 10 s
DOWN_SAMPLES=${FAN_DOWN_SAMPLES:-6} # 6 x 5 s = 30 s

[ -x "$HELPER" ] || exit 0
"$HELPER" supported >/dev/null 2>&1 || exit 0
mkdir -p "$CACHE_DIR" 2>/dev/null || true

state() { cat "$STATE" 2>/dev/null || printf 'auto'; }

temp_c() {
  local h v max=0
  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    if [ "$(cat "$h/name" 2>/dev/null)" = coretemp ]; then
      v=$(cat "$h/temp1_input" 2>/dev/null || printf '')
      case "$v" in ''|*[!0-9]*) ;; *) printf '%s\n' $((v / 1000)); return 0 ;; esac
    fi
  done
  for h in /sys/class/hwmon/hwmon*/temp*_input; do
    [ -r "$h" ] || continue
    v=$(cat "$h" 2>/dev/null || printf '')
    case "$v" in ''|*[!0-9]*) continue ;; esac
    v=$((v / 1000))
    [ "$v" -gt "$max" ] && max=$v
  done
  [ "$max" -gt 0 ] && printf '%s\n' "$max"
}

apply_mode() {
  sudo -n "$HELPER" set "$1" >/dev/null 2>&1 || return 1
  printf '%s\n' "$1" >"$EFFECTIVE" 2>/dev/null || true
}

# Una lectura de /proc/stat: idle y total.
stat_pair() {
  awk '/^cpu /{ idle=$5; total=0; for (i=2;i<=8;i++) total+=$i; print idle, total; exit }' /proc/stat
}

pidle=""
ptotal=""
cur=$(cat "$EFFECTIVE" 2>/dev/null || printf 'normal')
# Un modo manual (p. ej. silent) no es válido como estado de auto.
case "$cur" in
  normal|overboost) ;;
  *) cur=normal ;;
esac
up_ct=0
down_ct=0
forced_once=0
[ "${1:-}" = "--once" ] && forced_once=1

# Estado inicial: si estamos en auto, deja el modo efectivo aplicado.
if [ "$(state)" = auto ]; then
  apply_mode "$cur" || true
fi

while :; do
  if [ "$(state)" != auto ]; then
    up_ct=0
    down_ct=0
    [ "$forced_once" -eq 1 ] && exit 0
    sleep "$POLL"
    continue
  fi

  set -- $(stat_pair)
  idle=${1:-0}
  total=${2:-0}
  load=0
  if [ -n "$pidle" ] && [ "$total" -gt "$ptotal" ]; then
    di=$((idle - pidle))
    dt=$((total - ptotal))
    [ "$dt" -gt 0 ] && load=$((100 - (di * 100 / dt)))
  fi
  pidle=$idle
  ptotal=$total

  temp=$(temp_c)
  [ -n "$temp" ] || temp=0

  if [ "$temp" -ge "$T_HIGH" ] || [ "$load" -ge "$L_HIGH" ]; then
    up_ct=$((up_ct + 1))
    down_ct=0
  elif [ "$temp" -le "$T_LOW" ] && [ "$load" -lt "$L_LOW" ]; then
    down_ct=$((down_ct + 1))
    up_ct=0
  else
    up_ct=0
    down_ct=0
  fi

  if [ "$cur" != overboost ] && [ "$up_ct" -ge "$UP_SAMPLES" ]; then
    apply_mode overboost && cur=overboost
    up_ct=0
  elif [ "$cur" = overboost ] && [ "$down_ct" -ge "$DOWN_SAMPLES" ]; then
    apply_mode normal && cur=normal
    down_ct=0
  fi

  if [ "$forced_once" -eq 1 ]; then
    exit 0
  fi
  sleep "$POLL"
done
