#!/usr/bin/env bash
# theme-mode — alterna el escritorio entre Catppuccin Mocha Black y Latte.
#
# Uso:
#   theme-mode dark       Mocha Black (oscuro)
#   theme-mode light      Latte (claro)
#   theme-mode toggle     cambia al modo contrario
#   theme-mode status     muestra el modo actual
#   theme-mode --no-reload dark   solo re-renderiza, sin recargar servicios
#
# Re-renderiza las configuraciones desde las plantillas instaladas en
# ~/.local/share/dwm-setup y recarga lo que se puede en caliente.
# No necesita sudo: los temas GTK e iconos ya están en /usr/share.
set -Eeuo pipefail

PROG="theme-mode"

STORE="${DWM_THEME_STORE:-${XDG_DATA_HOME:-$HOME/.local/share}/dwm-setup}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dwm-setup"
MODE_FILE="$CONFIG_DIR/mode"
GTK_ENV="$CONFIG_DIR/gtk.env"
RENDER_ENV="$STORE/render.env"
HOME_DIR="${HOME}"

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }

usage() {
  cat <<'EOF'
Uso: theme-mode [--no-reload] <dark|light|toggle|status>

  dark      Catppuccin Mocha Black (oscuro)
  light     Catppuccin Latte (claro)
  toggle    cambia al modo contrario
  status    muestra el modo actual

  --no-reload   re-renderiza sin reiniciar polybar ni dunst
  -h, --help    esta ayuda

No requiere sudo. VLC necesita reiniciarse para aplicar el cambio.
EOF
}

theme_for_mode() {
  case "$1" in
    dark) printf 'mocha-black\n' ;;
    light) printf 'latte\n' ;;
    *) return 1 ;;
  esac
}

current_mode() {
  local mode=""
  [[ -f "$MODE_FILE" ]] && mode=$(<"$MODE_FILE")
  case "$mode" in
    dark|light) printf '%s\n' "$mode" ;;
    *) printf 'dark\n' ;;
  esac
}

# Lee un valor de render.env sin sourcearlo (los valores llevan espacios).
env_get() {
  local key="$1"
  sed -n "s/^${key}=//p" "$RENDER_ENV" 2>/dev/null | head -1
}

require_store() {
  [[ -f "$RENDER_ENV" ]] ||
    die "no existe $RENDER_ENV; ejecuta el instalador (./install.sh) primero"
  [[ -d "$STORE/colors" ]] || die "faltan las paletas en $STORE/colors"
  [[ -d "$STORE/templates" ]] || die "faltan las plantillas en $STORE/templates"
}

load_theme() {
  local theme="$1"
  local file="$STORE/colors/palette-$theme.sh"
  [[ -f "$file" ]] || die "paleta no encontrada: $file"

  # shellcheck source=/dev/null
  source "$STORE/colors/base.sh"
  # shellcheck source=/dev/null
  source "$file"
  THEME_NAME="$theme"
}

# render_one <ruta relativa en templates> <destino> <permisos>
render_one() {
  local rel="$1" dst="$2" perms="$3"
  local src="$STORE/templates/$rel"
  local content key val var

  if [[ ! -f "$src" ]]; then
    printf '%s: warn: falta la plantilla %s\n' "$PROG" "$src" >&2
    return 0
  fi

  content=$(<"$src")

  while IFS='=' read -r key val; do
    [[ -n "$key" ]] || continue
    content=${content//@$key@/$val}
  done <"$RENDER_ENV"

  content=${content//@THEME_NAME@/$THEME_NAME}

  for var in $(compgen -v); do
    case "$var" in
      COLOR_*|THEME_*)
        content=${content//@$var@/${!var}}
        ;;
    esac
  done

  mkdir -p -- "$(dirname -- "$dst")"
  printf '%s\n' "$content" >"$dst"
  chmod "$perms" -- "$dst"
}

render_mode() {
  local h="$HOME_DIR"

  render_one "polybar/config.ini.in" "$h/.config/polybar/config.ini" 0644
  render_one "polybar/variants/reference/config.ini.in" \
    "$h/.config/polybar/variants/reference/config.ini" 0644
  render_one "polybar/scripts/cpu-governor.sh.in" \
    "$h/.config/polybar/scripts/cpu-governor.sh" 0755
  render_one "polybar/scripts/fan-mode.sh.in" \
    "$h/.config/polybar/scripts/fan-mode.sh" 0755
  render_one "polybar/scripts/ufw-status.sh.in" \
    "$h/.config/polybar/scripts/ufw-status.sh" 0755
  render_one "polybar/scripts/bluetooth-status.sh.in" \
    "$h/.config/polybar/scripts/bluetooth-status.sh" 0755
  render_one "polybar/scripts/recording-status.sh.in" \
    "$h/.config/polybar/scripts/recording-status.sh" 0755
  render_one "picom/picom.conf.in" "$h/.config/picom/picom.conf" 0644
  render_one "kitty/kitty.conf.in" "$h/.config/kitty/kitty.conf" 0644
  render_one "kitty/colorshemes/monochromatic.conf.in" \
    "$h/.config/kitty/colorshemes/monochromatic.conf" 0644
  render_one "dunst/dunstrc.in" "$h/.config/dunst/dunstrc" 0644
  render_one "rofi/config.rasi.in" "$h/.config/rofi/config.rasi" 0644
  render_one "rofi/powermenu.rasi.in" "$h/.config/rofi/powermenu.rasi" 0644
  render_one "zathura/zathurarc.in" "$h/.config/zathura/zathurarc" 0644
  render_one "fastfetch/config.jsonc.in" "$h/.config/fastfetch/config.jsonc" 0644
  render_one "bspwm/bspwmrc.in" "$h/.config/bspwm/bspwmrc" 0755
  render_one "gtk/gtk-3.0.settings.ini.in" "$h/.config/gtk-3.0/settings.ini" 0644
  render_one "gtk/gtk-3.0.css.in" "$h/.config/gtk-3.0/gtk.css" 0644
  render_one "gtk/gtk-4.0.settings.ini.in" "$h/.config/gtk-4.0/settings.ini" 0644
  render_one "gtk/gtk-4.0.css.in" "$h/.config/gtk-4.0/gtk.css" 0644
  render_one "gtk/gtkrc-2.0.in" "$h/.gtkrc-2.0" 0644
  render_one "xsettingsd/xsettingsd.conf.in" \
    "$h/.config/xsettingsd/xsettingsd.conf" 0644
  render_one "brave/newtab.html.in" \
    "$h/.local/share/dwm-setup/newtab.html" 0644
  render_one "vlc/vlcrc.in" "$h/.config/vlc/vlcrc" 0600

}

write_state() {
  local mode="$1"
  mkdir -p -- "$CONFIG_DIR"
  printf '%s\n' "$mode" >"$MODE_FILE"

  {
    printf 'GTK_THEME=%s\n' "$THEME_GTK"
    printf 'ICON_THEME=%s\n' "$THEME_ICONS"
    printf 'MODE=%s\n' "$mode"
    printf 'THEME=%s\n' "$THEME_NAME"
  } >"$GTK_ENV"
}

# Asegura «Usar GTK» en Brave. Es una escritura de prefs, no una recarga
# de servicio: también corre con --no-reload. Devuelve 3 si hay cambios
# pendientes y Brave está abierto (se aplicarán en el siguiente arranque).
apply_brave_theme() {
  local mode="$1"
  local helper="$HOME_DIR/.local/bin/brave-theme"
  local rc=0

  [[ -x "$helper" ]] || return 0
  "$helper" apply --mode "$mode" --quiet || rc=$?
  case "$rc" in
    0) info "Brave: «Usar GTK» asegurado" ;;
    3) info "Brave: abierto; «Usar GTK» se aplicará al reiniciarlo" ;;
    *) info "Brave: no se pudo asegurar «Usar GTK» (se reintentará al abrirlo)" ;;
  esac
  return "$rc"
}

apply_bspwm_colors() {
  local file="$HOME_DIR/.config/bspwm/bspwmrc"
  local line

  command -v bspc >/dev/null 2>&1 || return 0
  bspc query -N >/dev/null 2>&1 || return 0
  [[ -f "$file" ]] || return 0

  while IFS= read -r line; do
    [[ "$line" == bspc\ config\ *_color* ]] || continue
    eval "$line" >/dev/null 2>&1 || true
  done <"$file"
}

reload_polybar() {
  pgrep -x polybar >/dev/null 2>&1 || return 1
  if command -v polybar-msg >/dev/null 2>&1 &&
     polybar-msg cmd restart >/dev/null 2>&1; then
    return 0
  fi
  pkill -x polybar 2>/dev/null || true
  sleep 0.3
  if [[ -x "$HOME_DIR/.config/polybar/launch.sh" ]]; then
    setsid "$HOME_DIR/.config/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  return 0
}

reload_kitty() {
  command -v kitty >/dev/null 2>&1 || return 1

  local colors="$HOME_DIR/.config/kitty/colorshemes/monochromatic.conf"
  [[ -f "$colors" ]] || return 1

  local pid any=1
  for pid in $(pgrep -x kitty 2>/dev/null); do
    # listen_on unix:kitty-{kitty_pid} -> /tmp/kitty-<pid>
    if timeout 2 kitty @ --to "unix:/tmp/kitty-$pid" \
         set-colors --all --configured "$colors" >/dev/null 2>&1; then
      any=0
    fi
  done
  return "$any"
}

reload_dunst() {
  pgrep -x dunst >/dev/null 2>&1 || return 1
  pkill -x dunst 2>/dev/null || true
  sleep 0.3
  setsid dunst >/dev/null 2>&1 &
  return 0
}

# Reinicia picom para aplicar el halo del acento del nuevo modo.
reload_picom() {
  command -v picom >/dev/null 2>&1 || return 1
  pgrep -x picom >/dev/null 2>&1 || return 1
  pkill -x picom 2>/dev/null || true
  sleep 0.3
  setsid picom -b --config "$HOME_DIR/.config/picom/picom.conf" >/dev/null 2>&1 &
  return 0
}

# Publica el tema GTK del modo activo por XSETTINGS. Si xsettingsd no
# corre, lo arranca; si corre, SIGHUP le hace releer el config. Así Brave
# y las apps GTK cambian sin reiniciarse.
reload_xsettings() {
  local conf="$HOME_DIR/.config/xsettingsd/xsettingsd.conf"

  command -v xsettingsd >/dev/null 2>&1 || return 1
  [[ -f "$conf" ]] || return 1

  if pgrep -x xsettingsd >/dev/null 2>&1; then
    pkill -HUP -x xsettingsd 2>/dev/null && return 0
  fi

  [[ -n "${DISPLAY:-}" ]] || return 1
  setsid xsettingsd -c "$conf" >/dev/null 2>&1 &
  sleep 0.2
  pgrep -x xsettingsd >/dev/null 2>&1
}

# Vuelve a aplicar el wallpaper del modo recién activado (dark/light).
reload_wallpaper() {
  local script="$HOME_DIR/.config/bspwm/scripts/wallpaper.sh"
  [[ -x "$script" ]] || return 1
  "$script" apply >/dev/null 2>&1 || return 1
  return 0
}

# Ajusta el tema de la TUI de Herdr en su config (se aplica al recargar).
update_herdr_theme() {
  local mode="$1" name sidebar panel active selection config
  case "$mode" in
    dark)
      name="catppuccin"
      sidebar="#0d0d14"
      panel="#0d0d14"
      active="#1a1a24"
      selection="#26262f"
      ;;
    light)
      name="catppuccin-latte"
      sidebar="#eff1f5"
      panel="#eff1f5"
      active="#e6e9ef"
      selection="#bdd0f5"
      ;;
    *) return 1 ;;
  esac
  config="$HOME_DIR/.config/herdr/config.toml"
  [[ -f "$config" ]] || return 1

  # Herdr no admite dos tablas [theme.custom]. Si una versión anterior
  # dejó duplicados, se funden en la primera antes de escribir.
  python3 - "$config" <<'PYDEDUP'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    lines = fh.read().splitlines()

starts = [i for i, line in enumerate(lines) if line.strip() == "[theme.custom]"]
if len(starts) > 1:
    def section_end(start):
        end = start + 1
        while end < len(lines):
            stripped = lines[end].strip()
            if stripped.startswith("[") and stripped.endswith("]"):
                break
            end += 1
        return end

    sections = [(start, section_end(start)) for start in starts]
    first_start, first_end = sections[0]
    keys = set()
    for line in lines[first_start + 1:first_end]:
        match = re.match(r"^\s*([A-Za-z0-9_.-]+)\s*=", line)
        if match:
            keys.add(match.group(1))

    extra = []
    remove = set()
    for start, end in sections[1:]:
        for line in lines[start + 1:end]:
            match = re.match(r"^\s*([A-Za-z0-9_.-]+)\s*=", line)
            if match and match.group(1) not in keys:
                extra.append(line)
                keys.add(match.group(1))
        remove.update(range(start, end))

    merged = []
    inserted = False
    for i, line in enumerate(lines):
        if i in remove:
            continue
        if i == first_end:
            merged.extend(extra)
            inserted = True
        merged.append(line)
    if not inserted:
        merged.extend(extra)

    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(merged) + "\n")
PYDEDUP

  python3 - "$config" "$name" "$sidebar" "$panel" "$active" "$selection" <<'PYEOF'
import re
import sys

path, name, sidebar, panel, active, selection = sys.argv[1:7]
with open(path, encoding="utf-8") as fh:
    lines = fh.read().splitlines()


def section_range(header):
    for i, line in enumerate(lines):
        if line.strip() == header:
            j = i + 1
            while j < len(lines):
                stripped = lines[j].strip()
                if stripped.startswith("[") and stripped.endswith("]"):
                    break
                j += 1
            return i, j
    return None


def set_key(header, key, value):
    rng = section_range(header)
    if rng is None:
        lines.extend(["", header, f'{key} = "{value}"'])
        return
    start, end = rng
    for i in range(start + 1, end):
        if re.match(rf"^\s*{re.escape(key)}\s*=", lines[i]):
            indent = lines[i][: len(lines[i]) - len(lines[i].lstrip())]
            lines[i] = f'{indent}{key} = "{value}"'
            return
    lines.insert(end, f'{key} = "{value}"')


set_key("[theme]", "name", name)
rng = section_range("[theme]")
if rng is not None:
    start, end = rng
    for i in range(start + 1, end):
        if re.match(r"^\s*auto_switch\s*=", lines[i]):
            indent = lines[i][: len(lines[i]) - len(lines[i].lstrip())]
            lines[i] = f"{indent}auto_switch = false"
            break

set_key("[theme.custom]", "sidebar_bg", sidebar)
set_key("[theme.custom]", "panel_bg", panel)
set_key("[theme.custom]", "active_row_bg", active)
set_key("[theme.custom]", "selection_bg", selection)

with open(path, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
PYEOF
}


# Ajusta el tema del TUI de opencode en su config JSON.
update_opencode_theme() {
  local mode="$1" tm name config theme_dir theme_src
  case "$mode" in
    dark) tm="dark"; name="mocha-black" ;;
    light) tm="light"; name="catppuccin" ;;
    *) return 1 ;;
  esac
  config="$HOME_DIR/.config/opencode/cli.json"
  [[ -f "$config" ]] || return 1

  # Tema custom: Catppuccin con las superficies de mocha-black.
  theme_dir="$HOME_DIR/.config/opencode/themes"
  theme_src="$HOME_DIR/.local/share/dwm-setup/templates/opencode/mocha-black.json"
  if [[ -f "$theme_src" ]]; then
    mkdir -p "$theme_dir" 2>/dev/null || true
    cp "$theme_src" "$theme_dir/mocha-black.json" 2>/dev/null || true
  fi

  python3 - "$config" "$name" "$tm" <<'PYOPENCODE'
import json
import sys

path, name, mode = sys.argv[1:4]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)

theme = data.get("theme")
if not isinstance(theme, dict):
    theme = {}
theme["name"] = name
theme["mode"] = mode
data["theme"] = theme

with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, ensure_ascii=False, indent=2)
    fh.write("\n")
PYOPENCODE
}

# Recarga el TUI/servicio de opencode para aplicar el tema.
reload_opencode() {
  local config="$HOME_DIR/.config/opencode/cli.json"
  command -v opencode >/dev/null 2>&1 || return 1
  [[ -f "$config" ]] || return 1
  pgrep -f 'opencode' >/dev/null 2>&1 || return 1
  opencode reload >/dev/null 2>&1 || return 1
  return 0
}


# Recarga el servidor de Herdr; los clientes releen el config y aplican
# el tema en caliente (incluidos [theme.custom] sidebar/panel).
reload_herdr() {
  local config="$HOME_DIR/.config/herdr/config.toml"
  command -v herdr >/dev/null 2>&1 || return 1
  [[ -f "$config" ]] || return 1
  herdr status server >/dev/null 2>&1 || return 1
  herdr server reload-config >/dev/null 2>&1 || return 1
  return 0
}


apply_gtk() {
  command -v gsettings >/dev/null 2>&1 || return 0
  gsettings set org.gnome.desktop.interface gtk-theme "$THEME_GTK" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface icon-theme "$THEME_ICONS" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface color-scheme "${THEME_COLOR_SCHEME:-default}" 2>/dev/null || true
}

notify_mode() {
  local mode="$1" theme="$2" brave_rc="${3:-0}" title label

  command -v notify-send >/dev/null 2>&1 || return 0
  [[ "${DWM_THEME_NO_NOTIFY:-0}" == "1" ]] && return 0

  case "$mode" in
    dark) title="Modo oscuro" ;;
    light) title="Modo claro" ;;
    *) return 0 ;;
  esac

  case "$theme" in
    mocha-black) label="Catppuccin Mocha Black" ;;
    latte) label="Catppuccin Latte" ;;
    *) label="$theme" ;;
  esac
  [[ "$brave_rc" == "3" ]] && label="$label · Brave: «Usar GTK» al reiniciarlo"

  notify-send -a "Tema" -i preferences-desktop-theme -t 2500 \
    "$title" "$label" 2>/dev/null || true
}

apply_live() {
  local -a done_parts=()

  apply_bspwm_colors
  done_parts+=("bspwm")
  reload_polybar && done_parts+=("polybar")
  reload_dunst && done_parts+=("dunst")
  reload_wallpaper && done_parts+=("wallpaper")
  reload_picom && done_parts+=("picom")
  reload_kitty && done_parts+=("kitty")
  reload_herdr && done_parts+=("herdr")
  reload_opencode && done_parts+=("opencode")
  reload_xsettings && done_parts+=("xsettingsd")
  apply_gtk
  done_parts+=("GTK")

  printf '  recargado: %s\n' "$(IFS=', '; printf '%s' "${done_parts[*]}")"
  if [[ " ${done_parts[*]} " != *" kitty "* ]]; then
    info "kitty: sin socket de control remoto; reinícialo para ver la paleta"
  fi
  if [[ " ${done_parts[*]} " != *" herdr "* ]] &&
     pgrep -f '^(.*/)?herdr$' >/dev/null 2>&1; then
    info "Herdr: no se pudo recargar; usa Ctrl+B Shift+R"
  fi
  if [[ " ${done_parts[*]} " != *" opencode "* ]] &&
     pgrep -f 'opencode' >/dev/null 2>&1; then
    info "opencode: no se pudo recargar; ejecuta 'opencode reload'"
  fi
  info "VLC: reinicia la app para aplicar el cambio"
}

cmd_status() {
  local mode theme
  mode=$(current_mode)
  theme=$(theme_for_mode "$mode")


  printf '%s: %s (%s)\n' "$PROG" "$mode" "$theme"
  if [[ -f "$GTK_ENV" ]]; then
    # shellcheck source=/dev/null
    source "$GTK_ENV"
    printf '  GTK: %s · iconos: %s\n' "${GTK_THEME:-?}" "${ICON_THEME:-?}"
  fi
}

main() {
  local mode="" reload=1

  while (($# > 0)); do
    case "$1" in
      --no-reload) reload=0 ;;
      -h|--help) usage; exit 0 ;;
      dark|light|toggle|status) mode="$1" ;;
      *) die "opción desconocida: $1 (usa --help)" ;;
    esac
    shift
  done

  [[ -n "$mode" ]] || { usage; exit 2; }

  if [[ "$mode" == "status" ]]; then
    cmd_status
    exit 0
  fi

  require_store

  if [[ "$mode" == "toggle" ]]; then
    if [[ "$(current_mode)" == "dark" ]]; then mode="light"; else mode="dark"; fi
  fi

  local theme
  theme=$(theme_for_mode "$mode") || die "modo inválido: $mode"

  load_theme "$theme"
  render_mode
  write_state "$mode"
  update_herdr_theme "$mode" || true
  update_opencode_theme "$mode" || true

  printf '%s: %s (%s)\n' "$PROG" "$mode" "$theme"
  local brave_rc=0
  apply_brave_theme "$mode" || brave_rc=$?

  if ((reload)); then
    apply_live
  else
    info "sin recargar servicios (--no-reload)"
  fi
  notify_mode "$mode" "$theme" "$brave_rc"
}

main "$@"
