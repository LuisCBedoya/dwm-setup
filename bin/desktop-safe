#!/bin/sh
# desktop-safe — Acciones de sesión seguras (lock/suspend/logout/poweroff)
# Instalado en /usr/local/bin/desktop-safe

set -eu

action="${1:-lock}"

case "$action" in
  lock)
    # Color de fondo desde la paleta activa; si el store no existe, Mocha Black.
    bg="#0d0d14"
    store="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-setup"
    mode_file="${XDG_CONFIG_HOME:-$HOME/.config}/dwm-setup/mode"
    mode=dark
    if [ -r "$mode_file" ]; then
      mode=$(cat "$mode_file" 2>/dev/null || printf 'dark')
    fi
    case "$mode" in
      light) palette="$store/colors/palette-latte.sh" ;;
      *)     palette="$store/colors/palette-mocha-black.sh" ;;
    esac
    if [ -r "$palette" ]; then
      bg=$(sed -n 's/^export COLOR_BG="\([^"]*\)".*/\1/p' "$palette" | head -1)
    fi
    [ -n "$bg" ] || bg="#0d0d14"
    i3lock -c "${bg#\#}" -n -e -f
    ;;
  suspend)
    systemctl suspend
    ;;
  logout)
    bspc quit
    ;;
  poweroff)
    systemctl poweroff
    ;;
  reboot)
    systemctl reboot
    ;;
  *)
    printf 'Uso: desktop-safe {lock|suspend|logout|poweroff|reboot}\n' >&2
    exit 1
    ;;
esac