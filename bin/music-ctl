#!/usr/bin/env bash
# music-ctl — teclas multimedia para el reproductor activo.
# Hoy: mpv (vía MPRIS/playerctl). Preparado para cmus cuando se añada.
set -Eeuo pipefail

action="${1:-play-pause}"

usage() {
  cat <<'EOF'
Uso: music-ctl <play-pause|next|prev|stop|forward|backward>

  play-pause  pausa/reanuda todos los reproductores MPRIS
  stop        detiene todos (tu "quitar" cuando hay varias instancias)
  next/prev   siguiente/anterior en el reproductor activo
  forward      adelanta 10 s
  backward     retrocede 10 s
Sin reproductor, no hace nada.
EOF
}

case "$action" in
  -h|--help) usage; exit 0 ;;
  play-pause|next|prev|stop|forward|backward) ;;
  *) usage >&2; exit 2 ;;
esac

if command -v playerctl >/dev/null 2>&1 && [[ -n "$(playerctl -l 2>/dev/null)" ]]; then
  case "$action" in
    play-pause) playerctl -a play-pause ;;
    next)       playerctl next ;;
    prev)       playerctl previous ;;
    stop)       playerctl -a stop ;;
    forward)    playerctl position 10+ ;;
    backward)   playerctl position 10- ;;
  esac
  exit 0
fi

# cmus todavía no está instalado; si algún día lo está, aquí iría:
# if command -v cmus-remote >/dev/null 2>&1 && cmus-remote -Q >/dev/null 2>&1; then
#   case "$action" in
#     play-pause) cmus-remote -u ;;
#     next)       cmus-remote -n ;;
#     prev)       cmus-remote -r ;;
#     stop)       cmus-remote -s ;;
#   esac
# fi

exit 0
