#!/bin/sh
# luc-workspace-fan-mode — modo del ventilador según el firmware del portátil.
#
# Backends (el primero que exista):
#  1) ASUS fan_boost_mode        (0 normal, 1 overboost, 2 silent)
#  2) ASUS throttle_thermal_policy (0 default, 1 overboost, 2 silent)
#  3) ACPI platform_profile      (quiet / balanced / performance)
#
# Uso: luc-workspace-fan-mode supported|status|cycle|set <modo>
# Sale 1 si el equipo no expone ningún backend. Escribir requiere root.
set -u

ASUS_DIR=${LUC_WORKSPACE_ASUS_DIR:-/sys/devices/platform/asus-nb-wmi}
FAN_BOOST="$ASUS_DIR/fan_boost_mode"
THROTTLE="$ASUS_DIR/throttle_thermal_policy"
PROFILE=${LUC_WORKSPACE_PLATFORM_PROFILE:-/sys/firmware/acpi/platform_profile}
CHOICES=${LUC_WORKSPACE_PLATFORM_PROFILE_CHOICES:-/sys/firmware/acpi/platform_profile_choices}

backend() {
  if [ -e "$FAN_BOOST" ]; then
    printf '%s\n' fan_boost
    return 0
  fi
  if [ -e "$THROTTLE" ]; then
    printf '%s\n' throttle
    return 0
  fi
  if [ -r "$PROFILE" ] && [ -r "$CHOICES" ]; then
    printf '%s\n' profile
    return 0
  fi
  return 1
}

# Etiqueta legible a partir del valor de fan_boost/throttle.
label_of_value() {
  case "$1" in
    0) printf '%s\n' normal ;;
    1) printf '%s\n' overboost ;;
    2) printf '%s\n' silent ;;
    *) printf '%s\n' "desconocido($1)" ;;
  esac
}

value_of_label() {
  case "$1" in
    normal|default) printf '0' ;;
    overboost|performance|turbo) printf '1' ;;
    silent|quiet) printf '2' ;;
    *) return 1 ;;
  esac
}

file_of_backend() {
  case "$1" in
    fan_boost) printf '%s\n' "$FAN_BOOST" ;;
    throttle) printf '%s\n' "$THROTTLE" ;;
    profile) printf '%s\n' "$PROFILE" ;;
  esac
}

status_value() {
  local be
  be=$(backend) || return 1
  if [ "$be" = profile ]; then
    cat "$PROFILE" 2>/dev/null || return 1
  else
    label_of_value "$(cat "$(file_of_backend "$be")" 2>/dev/null || printf 'x')"
  fi
}

write_value() {
  local be="$1" val="$2" file
  file=$(file_of_backend "$be")
  printf '%s\n' "$val" >"$file" 2>/dev/null || return 1
  return 0
}

cycle_profile() {
  local cur next="" first="" seen=0 c
  cur=$(cat "$PROFILE" 2>/dev/null)
  for c in $(cat "$CHOICES" 2>/dev/null); do
    [ -n "$first" ] || first="$c"
    if [ "$seen" -eq 1 ] && [ -z "$next" ]; then
      next="$c"
    fi
    [ "$c" = "$cur" ] && seen=1
  done
  [ -n "$next" ] || next="$first"
  [ -n "$next" ] || return 1
  write_value profile "$next" || return 1
  printf '%s\n' "$next"
}

cycle_mode() {
  local be cur next
  be=$(backend) || return 1
  if [ "$be" = profile ]; then
    cycle_profile
    return $?
  fi
  cur=$(cat "$(file_of_backend "$be")" 2>/dev/null)
  case "$cur" in
    0) next=1 ;;
    1) next=2 ;;
    2) next=0 ;;
    *) next=0 ;;
  esac
  write_value "$be" "$next" || return 1
  label_of_value "$next"
}

set_mode() {
  local mode="$1" be val
  be=$(backend) || return 1
  if [ "$be" = profile ]; then
    case "$mode" in
      quiet|balanced|performance) ;;
      *) echo "modo no válido para platform_profile: $mode" >&2; return 2 ;;
    esac
    write_value profile "$mode" || return 1
    printf '%s\n' "$mode"
    return 0
  fi
  val=$(value_of_label "$mode") || { echo "modo no válido: $mode" >&2; return 2; }
  write_value "$be" "$val" || return 1
  label_of_value "$val"
}

case "${1:-status}" in
  supported)
    backend >/dev/null
    ;;
  status)
    status_value || { echo "sin control de ventilador" >&2; exit 1; }
    ;;
  cycle)
    cycle_mode || { echo "no se pudo cambiar el modo del ventilador" >&2; exit 1; }
    ;;
  set)
    [ $# -ge 2 ] || { echo "uso: $0 set <modo>" >&2; exit 2; }
    set_mode "$2" || exit $?
    ;;
  -h|--help)
    cat <<'EOF'
Uso: luc-workspace-fan-mode supported|status|cycle|set <modo>

  supported  exit 0 si hay backend de ventilador (ASUS o platform_profile)
  status     muestra el modo actual
  cycle      siguiente modo (normal -> overboost -> silent -> normal)
  set <modo> fija normal/overboost/silent (o quiet/balanced/performance)

Sin backend el comando sale 1 y el módulo de polybar se oculta.
EOF
    ;;
  *)
    echo "orden desconocida: $1" >&2
    exit 2
    ;;
esac
