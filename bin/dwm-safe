#!/bin/sh
# Acciones de sesión seguras para dwm.
# Se instala en /usr/local/bin/dwm-safe.
set -u

PATH="/usr/local/bin:/usr/bin:/bin:${PATH:-}"
WALLPAPER="${DWM_WALLPAPER:-$HOME/.local/share/wallpapers/rocky.jpg}"

notify_error() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "dwm-safe" "$*" >/dev/null 2>&1 || true
  fi
  printf 'dwm-safe: %s\n' "$*" >&2
}

lock_screen() {
  if ! command -v i3lock >/dev/null 2>&1; then
    notify_error "i3lock no está instalado"
    return 1
  fi
  if [ -r "$WALLPAPER" ]; then
    exec i3lock -i "$WALLPAPER" -c 000000 --clock --nofork
  else
    exec i3lock -c 000000 --clock --nofork
  fi
}

case "${1:-help}" in
  lock)
    lock_screen
    ;;
  suspend)
    # xss-lock recibe la señal de suspensión y bloquea antes de dormir.
    # Si no está vivo, suspender dejaría la sesión sin bloquear.
    if ! command -v pgrep >/dev/null 2>&1 || ! pgrep -x xss-lock >/dev/null 2>&1; then
      notify_error "xss-lock no está en ejecución; no se suspende para no dejar la sesión sin bloqueo"
      exit 1
    fi
    if command -v systemctl >/dev/null 2>&1; then
      exec systemctl suspend
    fi
    notify_error "systemctl no está disponible"
    exit 1
    ;;
  poweroff)
    if command -v systemctl >/dev/null 2>&1; then
      exec systemctl poweroff
    fi
    notify_error "systemctl no está disponible"
    exit 1
    ;;
  reboot)
    if command -v systemctl >/dev/null 2>&1; then
      exec systemctl reboot
    fi
    notify_error "systemctl no está disponible"
    exit 1
    ;;
  logout)
    if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
      exec loginctl terminate-session "$XDG_SESSION_ID"
    fi
    if command -v pkill >/dev/null 2>&1; then
      exec pkill -TERM -x dwm
    fi
    notify_error "no se pudo cerrar la sesión"
    exit 1
    ;;
  restart)
    # dwm se reinicia con Mod+Shift+R; este atajo es el fallback por CLI.
    if command -v pkill >/dev/null 2>&1; then
      exec pkill -TERM -x dwm
    fi
    exit 1
    ;;
  status|doctor)
    exec dwm-doctor
    ;;
  version|--version|-v)
    printf 'dwm-safe 1.0 (fase 1)\n'
    ;;
  help|--help|-h)
    cat <<'EOF'
Uso: dwm-safe <acción>

Acciones:
  lock       Bloquear la pantalla con i3lock
  suspend    Suspender (requiere xss-lock activo)
  poweroff   Apagar el equipo
  reboot     Reiniciar
  logout     Cerrar la sesión de dwm y volver a Ly
  restart    Terminar dwm (fallback; usa Mod+Shift+R)
  status     Ejecutar dwm-doctor
  version    Mostrar versión
EOF
    ;;
  *)
    printf 'dwm-safe: acción desconocida: %s\n' "$1" >&2
    exit 2
    ;;
esac
