#!/usr/bin/env bash
# ytdlp-rollback — restaura la copia anterior de yt-dlp (yt-dlp.bak).
set -Eeuo pipefail

PROG="ytdlp-rollback"
BIN="${YTDLP_BIN:-$HOME/.local/bin/yt-dlp}"

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

[[ -f "$BIN.bak" ]] || die "no hay copia de seguridad: $BIN.bak"

current=$("$BIN" --version 2>/dev/null || echo "desconocida")
install -m 0755 -- "$BIN.bak" "$BIN"
restored=$("$BIN" --version 2>/dev/null || echo "desconocida")

printf '  %s -> %s\n' "$current" "$restored"
if command -v notify-send >/dev/null 2>&1; then
  notify-send -a yt-dlp "yt-dlp: versión restaurada" "$restored" 2>/dev/null || true
fi
